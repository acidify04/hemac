def validate_args(args: argparse.Namespace) -> None:
    positive = (
        "iterations",
        "episodes_per_iteration",
        "eval_every",
        "eval_episodes",
        "ppo_epochs",
        "minibatch_size",
        "actor_lr",
        "base_head_lr",
        "encoder_lr",
        "skill_gate_lr",
        "skill_residual_lr",
        "context_lr",
        "critic_lr",
        "log_std_lr",
        "gamma",
        "gae_lambda",
        "clip_ratio",
        "target_kl",
        "reward_scale",
        "max_grad_norm",
    )
    for name in positive:
        if getattr(args, name) <= 0:
            raise ValueError(f"--{name.replace('_', '-')} must be positive.")
    if not 0.0 < args.success_min_coverage_ratio <= 1.0:
        raise ValueError("--success-min-coverage-ratio must be in (0, 1].")
    if not 0.0 < args.gamma <= 1.0 or not 0.0 < args.gae_lambda <= 1.0:
        raise ValueError("--gamma and --gae-lambda must be in (0, 1].")
    if args.log_std_min >= args.log_std_max:
        raise ValueError("--log-std-min must be lower than --log-std-max.")
    if args.anchor_coeff < 0.0 or args.skill_anchor_coeff < 0.0:
        raise ValueError("Anchor coefficients cannot be negative.")
    if not 0.0 <= args.skill_prior_init < 1.0:
        raise ValueError("--skill-prior-init must be in [0, 1).")
    if not 0.0 < args.skill_prior_max < 1.0:
        raise ValueError("--skill-prior-max must be in (0, 1).")
    if args.skill_prior_init > args.skill_prior_max:
        raise ValueError("--skill-prior-init cannot exceed --skill-prior-max.")
    if args.shared_terminal_crash_penalty < 0.0:
        raise ValueError("--shared-terminal-crash-penalty cannot be negative.")
    if args.rollback_score_drop < 0.0:
        raise ValueError("--rollback-score-drop cannot be negative.")
    if not 0.0 <= args.rollback_min_best_success <= 1.0:
        raise ValueError("--rollback-min-best-success must be in [0, 1].")
    if not 0.0 < args.rollback_lr_factor <= 1.0:
        raise ValueError("--rollback-lr-factor must be in (0, 1].")
    if args.rollback_patience <= 0:
        raise ValueError("--rollback-patience must be positive.")
    if args.context_warmup_iterations < 0:
        raise ValueError("--context-warmup-iterations cannot be negative.")
    if args.base_unfreeze_after_joint_steps < 0:
        raise ValueError("--base-unfreeze-after-joint-steps cannot be negative.")
    if args.encoder_unfreeze_after_joint_steps < 0:
        raise ValueError("--encoder-unfreeze-after-joint-steps cannot be negative.")
    if args.train_batch_joint_steps < 0:
        raise ValueError("--train-batch-joint-steps cannot be negative.")
    step_options = (
        args.joint_step_budget is not None,
        args.eval_every_joint_steps is not None,
    )
    if any(step_options) and not all(step_options):
        raise ValueError(
            "--joint-step-budget and --eval-every-joint-steps must be used together."
        )
    if args.joint_step_budget is not None:
        if args.joint_step_budget <= 0 or args.eval_every_joint_steps <= 0:
            raise ValueError("Joint-step budget and evaluation interval must be positive.")
        if args.eval_every_joint_steps > args.joint_step_budget:
            raise ValueError(
                "--eval-every-joint-steps cannot exceed --joint-step-budget."
            )
    if args.eval_seed_base is not None and args.eval_seed_base < 0:
        raise ValueError("--eval-seed-base cannot be negative.")
    args.method_name = args.method_name.strip()
    if not args.method_name:
        raise ValueError("--method-name cannot be empty.")


def configure_gpu_backend(device: torch.device) -> None:
    """Use fast CUDA kernels for repeated fixed-shape policy inference."""
    if device.type != "cuda":
        return
    torch.set_float32_matmul_precision("high")
    torch.backends.cudnn.benchmark = True
    torch.backends.cuda.matmul.allow_tf32 = True
    torch.backends.cudnn.allow_tf32 = True


def configure_backend(device: torch.device, deterministic: bool) -> None:
    if not deterministic:
        configure_gpu_backend(device)
        return
    os.environ.setdefault("CUBLAS_WORKSPACE_CONFIG", ":4096:8")
    torch.use_deterministic_algorithms(True)
    if device.type != "cuda":
        return
    torch.set_float32_matmul_precision("highest")
    torch.backends.cudnn.benchmark = False
    torch.backends.cudnn.deterministic = True
    torch.backends.cuda.matmul.allow_tf32 = False
    torch.backends.cudnn.allow_tf32 = False


def restore_online_evaluation_settings(
    args: argparse.Namespace, payload: dict[str, Any]
) -> dict[str, Any]:
    """Restore action-affecting settings saved with an online checkpoint."""
    metadata = payload.get("online_finetuning")
    if not isinstance(metadata, dict):
        raise ValueError(
            "--eval-only requires a checkpoint produced by "
            "finetune_hissd_drone_online.py."
        )
    hyperparameters = metadata.get("hyperparameters", {})
    if not isinstance(hyperparameters, dict):
        hyperparameters = {}
    for name in (
        "skill_mode",
        "skill_prior_init",
        "skill_prior_max",
        "use_pretrained_value",
        "credit_assignment",
        "reward_scale",
        "shared_terminal_crash_penalty",
    ):
        if name in hyperparameters:
            setattr(args, name, hyperparameters[name])
    return metadata


class OnlineSkillConditionedResidualPolicy(nn.Module):
    """Matched PPO residual that optionally receives frozen HiSSD skills."""

    def __init__(
        self,
        observation_dim: int,
        action_dim: int,
        hidden_dim: int,
        skill_dim: int = 0,
        skill_prior_init: float = 0.0,
        skill_prior_max: float = 0.25,
    ) -> None:
        super().__init__()
        self.skill_dim = skill_dim
        self.observation_network = nn.Sequential(
            nn.Linear(observation_dim, hidden_dim),
            nn.SiLU(),
            nn.LayerNorm(hidden_dim),
            nn.Linear(hidden_dim, action_dim),
        )
        self.skill_network = nn.Sequential(
            nn.Linear(2 * skill_dim, hidden_dim),
            nn.SiLU(),
            nn.LayerNorm(hidden_dim),
            nn.Linear(hidden_dim, action_dim),
        )
        self.skill_gate_network = nn.Linear(
            observation_dim + 2 * skill_dim, action_dim
        )
        initial_gate = float(skill_prior_init)
        maximum_gate = float(skill_prior_max)
        if not 0.0 < maximum_gate < 1.0:
            raise ValueError("skill_prior_max must be in (0, 1).")
        if not 0.0 <= initial_gate <= maximum_gate:
            raise ValueError("skill_prior_init must be in [0, skill_prior_max].")
        self.use_skill_prior = initial_gate > 0.0
        self.skill_prior_max = maximum_gate
        self.register_buffer(
            "initial_skill_prior_gate",
            torch.full((action_dim,), initial_gate),
        )
        nn.init.zeros_(self.observation_network[-1].weight)
        nn.init.zeros_(self.observation_network[-1].bias)
        nn.init.zeros_(self.skill_network[-1].weight)
        nn.init.zeros_(self.skill_network[-1].bias)
        nn.init.zeros_(self.skill_gate_network.weight)
        gate_probability = min(
            max(initial_gate / maximum_gate, 1e-6), 1.0 - 1e-6
        )
        nn.init.constant_(
            self.skill_gate_network.bias,
            math.log(gate_probability / (1.0 - gate_probability)),
        )

    def forward(
        self,
        observation_features: torch.Tensor,
        common_skills: torch.Tensor | None = None,
        task_skills: torch.Tensor | None = None,
    ) -> torch.Tensor:
        residual = self.observation_network(observation_features)
        if self.skill_dim and common_skills is not None and task_skills is not None:
            residual = residual + self.skill_network(
                torch.cat((common_skills, task_skills), dim=-1)
            )
        return residual

    def skill_prior_fraction(
        self,
        observation_features: torch.Tensor,
        common_skills: torch.Tensor,
        task_skills: torch.Tensor,
    ) -> torch.Tensor:
        if not self.use_skill_prior:
            return observation_features.new_zeros(
                *observation_features.shape[:-1],
                self.skill_gate_network.out_features,
            )
        gate_features = torch.cat(
            (observation_features, common_skills, task_skills), dim=-1
        )
        gate_features = F.layer_norm(gate_features, (gate_features.shape[-1],))
        return self.skill_prior_max * torch.sigmoid(
            self.skill_gate_network(gate_features)
        )


