OnlineNoSkillResidualPolicy = OnlineSkillConditionedResidualPolicy


def online_action_mean(
    model,
    residual_policy: OnlineSkillConditionedResidualPolicy,
    observation_features: torch.Tensor,
    common_skills: torch.Tensor,
    task_skills: torch.Tensor,
    skill_mode: str,
    action_scale: float,
    compute_skill_delta: bool = True,
) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
    """Build an environment-unit Gaussian mean and report skill influence."""
    base_logits = model.action_decoder.base_action_head(observation_features)
    base_action = torch.tanh(base_logits) * action_scale
    if skill_mode == "no_skill":
        return (
            base_action + residual_policy(observation_features),
            base_logits.new_zeros(()),
            base_action,
        )

    pretrained_logits = model.decode_action_logits(
        observation_features, common_skills, task_skills
    )
    pretrained_action = torch.tanh(pretrained_logits) * action_scale
    skill_prior = residual_policy.skill_prior_fraction(
        observation_features, common_skills, task_skills
    ) * (
        pretrained_action - base_action
    )
    action_mean = base_action + residual_policy(
        observation_features, common_skills, task_skills
    ) + skill_prior
    if compute_skill_delta:
        no_skill_action = base_action + residual_policy(observation_features)
        skill_action_delta = (action_mean - no_skill_action).abs().mean()
    else:
        skill_action_delta = base_logits.new_zeros(())
    return action_mean, skill_action_delta, base_action


def load_checkpoint_env_config(path: Path) -> tuple[Path, dict[str, Any]]:
    """Read only RLlib's environment configuration without starting Ray."""
    checkpoint = resolve_algorithm_checkpoint(path)
    state_path = checkpoint / "algorithm_state.pkl"
    with state_path.open("rb") as file:
        state = pickle.load(file)
    config = state.get("config", {})
    env_config = dict(config.get("env_config", {}) or {})
    if int(env_config.get("n_observers", 0)) != 0:
        raise ValueError(
            "Drone-only learning efficiency requires an RLlib checkpoint with "
            "n_observers=0. Use finetune_hissd_online.py for the joint mission."
        )
    if int(env_config.get("n_drones", 0)) <= 0:
        raise ValueError("The RLlib checkpoint does not configure any drones.")
    return checkpoint, env_config


def per_drone_squashed_log_prob(
    distribution: Normal,
    raw_action: torch.Tensor,
) -> torch.Tensor:
    """Return one tanh-corrected log probability per shared-policy drone."""
    correction = 2.0 * (
        math.log(2.0) - raw_action - F.softplus(-2.0 * raw_action)
    )
    return (distribution.log_prob(raw_action) - correction).sum(dim=-1)


def per_drone_gaussian_log_prob(
    distribution: Normal,
    action: torch.Tensor,
) -> torch.Tensor:
    """Return one environment-action Gaussian log probability per drone."""
    return distribution.log_prob(action).sum(dim=-1)


def environment_action_distribution(
    action_mean: torch.Tensor,
    normalized_log_std: torch.Tensor,
    action_scale: float,
) -> Normal:
    """Match RLlib's normalized Gaussian after mapping it to environment units."""
    return Normal(action_mean, normalized_log_std.exp() * float(action_scale))


def final_fusion_linear(observation_encoder: nn.Module) -> nn.Linear:
    """Return the last trainable fusion projection without unfreezing the CNNs."""
    fusion = getattr(observation_encoder, "fusion", None)
    if fusion is None:
        raise ValueError("Observation encoder does not expose a fusion module.")
    linear_layers = [module for module in fusion.modules() if isinstance(module, nn.Linear)]
    if not linear_layers:
        raise ValueError("Observation encoder fusion module has no linear layer.")
    return linear_layers[-1]


def add_per_drone_gae(
    transitions: list[dict[str, Any]],
    gamma: float,
    gae_lambda: float,
) -> None:
    """Compute one GAE target per drone while sharing terminal success credit."""
    if not transitions:
        return

    first_value = transitions[0]["value"]
    if not torch.is_tensor(first_value):
        raise TypeError("Per-drone GAE expects tensor values.")

    device = first_value.device

    # Values already remain on the rollout device (CUDA during GPU training).
    values = torch.stack(
        [
            torch.as_tensor(
                transition["value"],
                dtype=torch.float32,
                device=device,
            )
            for transition in transitions
        ]
    )

    # Rewards are produced by the CPU environment. Stack them on CPU first,
    # then perform one batched transfer instead of one transfer per joint step.
    rewards = torch.stack(
        [
            torch.as_tensor(
                transition["reward"],
                dtype=torch.float32,
            )
            for transition in transitions
        ]
    ).to(device)

    if values.ndim != 2 or rewards.shape != values.shape:
        raise ValueError(
            "Per-drone GAE expects matching [T, N] reward/value tensors, got "
            f"reward={tuple(rewards.shape)}, value={tuple(values.shape)}."
        )

    advantages = torch.empty_like(values)
    advantage = torch.zeros_like(values[0])
    next_value = torch.zeros_like(values[0])

    for index in range(len(transitions) - 1, -1, -1):
        value = values[index]
        reward = rewards[index]
        delta = reward + gamma * next_value - value
        advantage = delta + gamma * gae_lambda * advantage
        advantages[index] = advantage
        next_value = value

    returns = advantages + values

    for index, transition in enumerate(transitions):
        transition["advantage"] = advantages[index].detach()
        transition["return"] = returns[index].detach()


def apply_shared_terminal_crash_penalty(
    cycle_rewards: np.ndarray,
    *,
    fatal_crash: bool,
    penalty: float,
) -> np.ndarray:
    """Assign a terminal cooperative failure to every drone without doubling it."""
    if not fatal_crash or penalty <= 0.0:
        return cycle_rewards
    return np.minimum(cycle_rewards, -abs(float(penalty)))


def combine_per_drone_rewards(
    local_rewards: np.ndarray,
    distributed_success_rewards: np.ndarray,
) -> np.ndarray:
    """Rebuild the rewards exposed by the environment to each drone."""
    if local_rewards.shape != distributed_success_rewards.shape:
        raise ValueError(
            "Local and distributed reward vectors must have matching shapes, got "
            f"{local_rewards.shape} and {distributed_success_rewards.shape}."
        )
    return local_rewards + distributed_success_rewards


def build_env_config(
    checkpoint_env_config: dict[str, Any],
    difficulty: int,
    success_min_coverage_ratio: float,
) -> dict[str, Any]:
    config = build_collection_env_config(checkpoint_env_config, difficulty)
    config["n_observers"] = 0
    config["drone_only_success_min_coverage_ratio"] = success_min_coverage_ratio
    return config


def rollout_episode(
    *,
    env,
    model,
    no_skill_policy: OnlineNoSkillResidualPolicy,
    value_head: OnlineValueHead,
    anchor_head: nn.Module,
    anchor_context_adapter: nn.Module | None,
    use_pretrained_value: bool,
    credit_assignment: str,
    log_std: torch.Tensor,
    action_scale: float,
    reward_scale: float,
    shared_terminal_crash_penalty: float,
    success_min_coverage_ratio: float,
    seed: int,
    device: torch.device,
    stochastic: bool,
    skill_mode: str,
) -> tuple[list[dict[str, Any]], dict[str, float]]:
    env.reset(seed=seed)
    core_env = get_core_env(env)
    agent_order = list(env.possible_agents)
    drone_ids = [agent_id for agent_id in agent_order if agent_id.startswith("drone_")]
    if len(drone_ids) != len(agent_order):
        raise ValueError("Drone-only fine-tuning received a non-drone agent.")
    drone_indices = list(range(len(drone_ids)))
    last_agent_id = agent_order[-1]
    valid_mask = torch.ones(1, len(drone_ids), dtype=torch.bool, device=device)
    recurrent_state = model.initial_inference_state(device=device)
    value_history = model.value_network.backbone.initial_state(
        1,
        len(drone_ids),
        device=device,
        dtype=next(model.parameters()).dtype,
    )
    transitions: list[dict[str, Any]] = []
    cached_actions: dict[str, np.ndarray] = {}
    cycle_rewards: np.ndarray | None = None
    distributed_success_rewards: np.ndarray | None = None
    cycle_mask: np.ndarray | None = None
    shared_success_reward = 0.0
    cycle_count = 0
    episode_return = 0.0

    for agent_id in env.agent_iter():
        _, _, termination, truncation, _ = env.last()
        if termination or truncation:
            env.step(None)
            continue

        if not cached_actions:
            observations = drone_observation_batch(env, drone_ids, action_scale, device)
            with torch.no_grad():
                outputs, recurrent_state = model.inference_step(
                    observations, valid_mask, recurrent_state
                )
                task_skill = outputs["task_skills"][0]
                observation_features = outputs["observation_features"][0]
                common_skills = outputs["common_skills"][0]
                task_context = recurrent_state["task_context"][0]
                context_adapter = (
                    getattr(model.task_skill_encoder, "context_adapter", None)
                    if model.skill_structure in {"split", "task_only"}
                    else None
                )
                if skill_mode == "no_skill":
                    task_base_skill = task_skill
                    anchor_task_skill = task_skill
                elif context_adapter is None:
                    task_base_skill = task_skill
                    anchor_task_skill = task_skill
                else:
                    task_base_skill = task_skill - context_adapter(
                        task_context
                    ).unsqueeze(0)
                    anchor_task_skill = task_base_skill + anchor_context_adapter(
                        task_context
                    ).unsqueeze(0)
                action_mean, skill_action_delta, base_action = online_action_mean(
                    model,
                    no_skill_policy,
                    observation_features,
                    common_skills,
                    task_skill,
                    skill_mode,
                    action_scale,
                    compute_skill_delta=False,
                )
                anchor_action_mean = base_action
                if skill_mode == "no_skill":
                    common_skills = torch.zeros_like(common_skills)
                    task_skill = torch.zeros_like(task_skill)
                central_map = (
                    torch.from_numpy(build_global_central_map(core_env))
                    .unsqueeze(0)
                    .to(device)
                )
                central_embedding = model.central_state_encoder(central_map)[0]
                if use_pretrained_value:
                    value_hidden, value_history = (
                        model.value_network.backbone.forward_step(
                            outputs["observation_features"],
                            valid_mask,
                            value_history,
                        )
                    )
                    individual_value = model.value_network.value_head(value_hidden)
                    pretrained_team_value = model.value_mixer(
                        individual_value,
                        central_embedding.unsqueeze(0),
                        valid_mask.to(individual_value.dtype),
                    ).squeeze()
                else:
                    pretrained_team_value = central_embedding.new_zeros(())
                if credit_assignment == "agent":
                    central_per_drone = central_embedding.unsqueeze(0).expand(
                        len(drone_ids), -1
                    )
                    critic_features = torch.cat(
                        (
                            observation_features,
                            common_skills,
                            task_skill,
                            central_per_drone,
                        ),
                        dim=-1,
                    )
                    pretrained_value = pretrained_team_value.expand(len(drone_ids))
                    value = pretrained_value + value_head(critic_features)
                else:
                    critic_features = torch.cat(
                        (
                            observation_features.mean(dim=0),
                            common_skills.mean(dim=0),
                            task_skill.mean(dim=0),
                            central_embedding,
                        ),
                        dim=-1,
                    )
                    pretrained_value = pretrained_team_value
                    value = pretrained_value + value_head(
                        critic_features.unsqueeze(0)
                    )[0]
                # RLlib learns a Gaussian in [-1, 1] action coordinates and its
                # connector maps both the mean and exploration scale to the
                # environment's [-action_scale, action_scale] coordinates.
                distribution = environment_action_distribution(
                    action_mean, log_std, action_scale
                )
                raw_action = distribution.sample() if stochastic else action_mean
                old_log_prob = per_drone_gaussian_log_prob(distribution, raw_action)

            for drone_index, drone_id in enumerate(drone_ids):
                action_space = env.action_space(drone_id)
                action = raw_action[drone_index].cpu().numpy()
                cached_actions[drone_id] = np.ascontiguousarray(
                    np.clip(action, action_space.low, action_space.high),
                    dtype=np.float32,
                )
            if stochastic:
                transitions.append(
                    {
                        "global_map": observations["global_map"][0].detach(),
                        "local_map": observations["local_map"][0].detach(),
                        "action_history": observations["action_history"][0].detach(),
                        "task_skill": task_skill.detach(),
                        "task_base_skill": task_base_skill.detach(),
                        "task_context": task_context.detach(),
                        "anchor_task_skill": anchor_task_skill.detach(),
                        "observation_features": observation_features.detach(),
                        "common_skills": common_skills.detach(),
                        "anchor_action_mean": anchor_action_mean.detach(),
                        "raw_action": raw_action.detach(),
                        "old_log_prob": old_log_prob.detach(),
                        "critic_features": critic_features.detach(),
                        "pretrained_value": pretrained_value.detach(),
                        "value": value.detach(),
                    }
                )
            cycle_rewards = np.zeros(len(agent_order), dtype=np.float32)
            distributed_success_rewards = np.zeros(
                len(agent_order), dtype=np.float32
            )
            cycle_mask = np.zeros(len(agent_order), dtype=np.bool_)
            shared_success_reward = 0.0

        index = drone_ids.index(agent_id)
        cycle_mask[index] = True
        env.step(cached_actions[agent_id])
        for reward_index, reward_agent_id in enumerate(drone_ids):
            cycle_rewards[reward_index] += _local_reward_after_step(
                core_env, reward_agent_id
            )
        shared_success_reward = max(shared_success_reward, float(core_env.global_reward))
        for reward_index, reward_agent_id in enumerate(drone_ids):
            distributed_success_rewards[reward_index] = max(
                distributed_success_rewards[reward_index],
                float(core_env._global_reward_for_agent(reward_agent_id)),
            )
        cycle_finished = (
            agent_id == last_agent_id
            or bool(core_env.terminate)
            or bool(core_env.truncate)
        )
        if not cycle_finished:
            continue
        cycle_rewards = apply_shared_terminal_crash_penalty(
            cycle_rewards,
            fatal_crash=bool(core_env.collided),
            penalty=shared_terminal_crash_penalty,
        )
        team_reward = _team_reward(
            cycle_rewards,
            cycle_mask,
            [],
            drone_indices,
            shared_success_reward,
        )
        episode_return += float(team_reward)
        if stochastic:
            transitions[-1]["agent_mask"] = torch.from_numpy(cycle_mask.copy())
            if credit_assignment == "agent":
                # Match the environment/RLlib semantics: local shaping remains
                # attributable and each drone receives its configured role share
                # of the global success reward (currently 0.25 * global reward).
                per_drone_reward = combine_per_drone_rewards(
                    cycle_rewards,
                    distributed_success_rewards,
                )
                transitions[-1]["reward"] = torch.from_numpy(
                    per_drone_reward / reward_scale
                )
            else:
                transitions[-1]["reward"] = float(team_reward / reward_scale)
        cycle_count += 1
        cached_actions = {}
        cycle_rewards = None
        distributed_success_rewards = None
        cycle_mask = None

    drone_goal_found = any(agent_found_goal(core_env, drone_id) for drone_id in drone_ids)
    coverage = float(core_env.current_coverage_ratio())
    reward_coverage = float(core_env.current_drone_reward_coverage_ratio())
    fatal_crash = bool(core_env.collided)
    # Keep evaluation identical to the environment's drone-only terminal rule:
    # goal found, reward coverage threshold reached, and no fatal collision.
    success = bool(core_env.mission_success)
    metrics = {
        "success": float(success),
        "goal_found": float(drone_goal_found),
        "fatal_crash": float(fatal_crash),
        "drone_crash": float(bool(core_env.drone_crash)),
        "observer_crash": 0.0,
        "coverage": coverage,
        "reward_coverage": reward_coverage,
        "cycles": float(cycle_count),
        "episode_return": float(episode_return),
    }
    return transitions, metrics



def _batch_rollout_state(states):
    """Concatenate independent recurrent states along their batch dimension."""
    first = states[0]

    if torch.is_tensor(first):
        if first.ndim == 0:
            return torch.stack(states, dim=0)
        return torch.cat(states, dim=0)

    if isinstance(first, dict):
        return {
            key: _batch_rollout_state([state[key] for state in states])
            for key in first
        }

    if isinstance(first, tuple):
        return tuple(
            _batch_rollout_state([state[index] for state in states])
            for index in range(len(first))
        )

    if isinstance(first, list):
        return [
            _batch_rollout_state([state[index] for state in states])
            for index in range(len(first))
        ]

    raise TypeError(
        f"Unsupported recurrent-state object: {type(first)!r}"
    )


def _slice_rollout_state(state, index: int):
    """Extract one environment while retaining its batch dimension."""
    if torch.is_tensor(state):
        if state.ndim == 0:
            return state
        return state[index:index + 1]

    if isinstance(state, dict):
        return {
            key: _slice_rollout_state(value, index)
            for key, value in state.items()
        }

    if isinstance(state, tuple):
        return tuple(
            _slice_rollout_state(value, index)
            for value in state
        )

    if isinstance(state, list):
        return [
            _slice_rollout_state(value, index)
            for value in state
        ]

    raise TypeError(
        f"Unsupported recurrent-state object: {type(state)!r}"
    )


def _batch_rollout_observations(items):
    """Combine B observation dictionaries whose leading dimension is 1."""
    keys = items[0].keys()

    return {
        key: torch.cat(
            [item[key] for item in items],
            dim=0,
        )
        for key in keys
    }


def _batched_episode_metrics(slot):
    core_env = slot["core_env"]
    drone_ids = slot["drone_ids"]

    goal_found = any(
        agent_found_goal(core_env, drone_id)
        for drone_id in drone_ids
    )

    return {
        "success": float(bool(core_env.mission_success)),
        "goal_found": float(goal_found),
        "fatal_crash": float(bool(core_env.collided)),
        "drone_crash": float(bool(core_env.drone_crash)),
        "observer_crash": 0.0,
        "coverage": float(core_env.current_coverage_ratio()),
        "reward_coverage": float(
            core_env.current_drone_reward_coverage_ratio()
        ),
        "cycles": float(slot["cycle_count"]),
        "episode_return": float(slot["episode_return"]),
    }



def _worker_observation_packet(
    env,
    core_env,
    drone_ids,
    action_scale: float,
):
    """Build raw CPU observations inside an environment worker.

    Keep action_history unnormalized here. The canonical observation
    path transfers the raw tensor to the target device first and only
    then divides by action_scale. Main-process rollout code performs
    that normalization on CUDA.
    """
    converted = [
        convert_observation(
            env.observe(agent_id),
            "drone",
        )
        for agent_id in drone_ids
    ]

    observations_np = {
        "global_map": np.ascontiguousarray(
            np.stack(
                [
                    item["global_map"]
                    for item in converted
                ]
            )[None, ...]
        ),
        "local_map": np.ascontiguousarray(
            np.stack(
                [
                    item["local_map"]
                    for item in converted
                ]
            )[None, ...]
        ),
        "action_history": np.ascontiguousarray(
            np.stack(
                [
                    item["action_history"]
                    for item in converted
                ]
            )[None, ...]
        ),
    }

    central_map = np.ascontiguousarray(
        build_global_central_map(core_env)
    )

    return {
        "observations": observations_np,
        "central_map": central_map,
    }


def _hemac_env_worker(
    connection,
    config,
    action_scale: float,
    reward_scale: float,
    shared_terminal_crash_penalty: float,
):
    """Own exactly one HeMAC environment in a CPU-only subprocess."""
    import traceback

    # Prevent each env process from creating its own large CPU thread pool.
    torch.set_num_threads(1)

    env = None

    try:
        env = HeMAC_v0.env(**config)

        core_env = get_core_env(env)
        agent_order = list(env.possible_agents)
        drone_ids = [
            agent_id
            for agent_id in agent_order
            if agent_id.startswith("drone_")
        ]

        if len(drone_ids) != len(agent_order):
            raise ValueError(
                "Multiprocess rollout requires drone-only HeMAC."
            )

        drone_index = {
            drone_id: index
            for index, drone_id in enumerate(drone_ids)
        }
        drone_indices = list(range(len(drone_ids)))
        last_agent_id = agent_order[-1]

        cycle_count = 0
        episode_return = 0.0

        def final_metrics():
            goal_found = any(
                agent_found_goal(core_env, drone_id)
                for drone_id in drone_ids
            )

            return {
                "success": float(bool(core_env.mission_success)),
                "goal_found": float(goal_found),
                "fatal_crash": float(bool(core_env.collided)),
                "drone_crash": float(bool(core_env.drone_crash)),
                "observer_crash": 0.0,
                "coverage": float(
                    core_env.current_coverage_ratio()
                ),
                "reward_coverage": float(
                    core_env.current_drone_reward_coverage_ratio()
                ),
                "cycles": float(cycle_count),
                "episode_return": float(episode_return),
            }

        while True:
            command, payload = connection.recv()

            if command == "close":
                break

            if command in {"reset", "reset_fresh"}:
                if command == "reset_fresh":
                    if env is not None:
                        env.close()

                    env = HeMAC_v0.env(**config)

                env.reset(seed=int(payload))

                # Wrapper keeps the same underlying HeMAC instance,
                # but refresh these references defensively.
                core_env = get_core_env(env)
                agent_order = list(env.possible_agents)
                drone_ids = [
                    agent_id
                    for agent_id in agent_order
                    if agent_id.startswith("drone_")
                ]
                drone_index = {
                    drone_id: index
                    for index, drone_id in enumerate(drone_ids)
                }
                drone_indices = list(range(len(drone_ids)))
                last_agent_id = agent_order[-1]

                cycle_count = 0
                episode_return = 0.0

                packet = _worker_observation_packet(
                    env,
                    core_env,
                    drone_ids,
                    action_scale,
                )

                connection.send(
                    (
                        "ok",
                        {
                            "packet": packet,
                            "drone_count": len(drone_ids),
                        },
                    )
                )
                continue

            if command != "step":
                raise RuntimeError(
                    f"Unknown worker command: {command!r}"
                )

            actions = np.asarray(
                payload,
                dtype=np.float32,
            )

            if actions.shape[0] != len(drone_ids):
                raise ValueError(
                    f"Expected actions for {len(drone_ids)} drones, "
                    f"got shape {actions.shape}"
                )

            cached_actions = {}

            for index, drone_id in enumerate(drone_ids):
                action_space = env.action_space(drone_id)

                cached_actions[drone_id] = np.ascontiguousarray(
                    np.clip(
                        actions[index],
                        action_space.low,
                        action_space.high,
                    ),
                    dtype=np.float32,
                )

            cycle_rewards = np.zeros(
                len(agent_order),
                dtype=np.float32,
            )
            distributed_success_rewards = np.zeros(
                len(agent_order),
                dtype=np.float32,
            )
            cycle_mask = np.zeros(
                len(agent_order),
                dtype=np.bool_,
            )
            shared_success_reward = 0.0

            cycle_completed = False

            while not cycle_completed:
                agent_id = env.agent_selection

                (
                    _,
                    _,
                    termination,
                    truncation,
                    _,
                ) = env.last()

                if termination or truncation:
                    env.step(None)

                    if not env.agents:
                        break

                    continue

                index = drone_index[agent_id]
                cycle_mask[index] = True

                env.step(
                    cached_actions[agent_id]
                )

                for (
                    reward_index,
                    reward_agent_id,
                ) in enumerate(drone_ids):
                    cycle_rewards[
                        reward_index
                    ] += _local_reward_after_step(
                        core_env,
                        reward_agent_id,
                    )

                shared_success_reward = max(
                    shared_success_reward,
                    float(core_env.global_reward),
                )

                for (
                    reward_index,
                    reward_agent_id,
                ) in enumerate(drone_ids):
                    distributed_success_rewards[
                        reward_index
                    ] = max(
                        distributed_success_rewards[
                            reward_index
                        ],
                        float(
                            core_env._global_reward_for_agent(
                                reward_agent_id
                            )
                        ),
                    )

                cycle_completed = (
                    agent_id == last_agent_id
                    or bool(core_env.terminate)
                    or bool(core_env.truncate)
                )

            if not cycle_completed:
                raise RuntimeError(
                    "HeMAC episode terminated before completing "
                    "the expected world cycle."
                )

            cycle_rewards = apply_shared_terminal_crash_penalty(
                cycle_rewards,
                fatal_crash=bool(core_env.collided),
                penalty=shared_terminal_crash_penalty,
            )

            team_reward = _team_reward(
                cycle_rewards,
                cycle_mask,
                [],
                drone_indices,
                shared_success_reward,
            )

            episode_return += float(team_reward)
            cycle_count += 1

            per_drone_reward = combine_per_drone_rewards(
                cycle_rewards,
                distributed_success_rewards,
            )

            done = bool(
                core_env.terminate
                or core_env.truncate
            )

            if done:
                # Match the original PettingZoo AEC dead-agent cleanup.
                while env.agents:
                    (
                        _,
                        _,
                        termination,
                        truncation,
                        _,
                    ) = env.last()

                    if not (
                        termination
                        or truncation
                    ):
                        break

                    env.step(None)

                next_packet = None
                metrics = final_metrics()

            else:
                next_packet = _worker_observation_packet(
                    env,
                    core_env,
                    drone_ids,
                    action_scale,
                )
                metrics = None

            connection.send(
                (
                    "ok",
                    {
                        "reward": np.ascontiguousarray(
                            per_drone_reward
                            / reward_scale,
                            dtype=np.float32,
                        ),
                        "agent_mask": np.ascontiguousarray(
                            cycle_mask,
                            dtype=np.bool_,
                        ),
                        "done": done,
                        "packet": next_packet,
                        "metrics": metrics,
                    },
                )
            )

    except BaseException:
        try:
            connection.send(
                (
                    "error",
                    traceback.format_exc(),
                )
            )
        except BaseException:
            pass
        raise

    finally:
        if env is not None:
            try:
                env.close()
            except BaseException:
                pass

        try:
            connection.close()
        except BaseException:
            pass


class HeMACWorkerPool:
    """Persistent CPU environment workers; CUDA stays in the parent."""

    def __init__(
        self,
        *,
        num_workers: int,
        config,
        action_scale: float,
        reward_scale: float,
        shared_terminal_crash_penalty: float,
    ):
        if num_workers <= 0:
            raise ValueError("num_workers must be positive")

        self.context = mp.get_context("spawn")
        self.connections = []
        self.processes = []

        for worker_index in range(num_workers):
            parent_connection, child_connection = (
                self.context.Pipe()
            )

            process = self.context.Process(
                target=_hemac_env_worker,
                args=(
                    child_connection,
                    config,
                    action_scale,
                    reward_scale,
                    shared_terminal_crash_penalty,
                ),
                name=f"hemac-rollout-{worker_index}",
                daemon=True,
            )

            process.start()
            child_connection.close()

            self.connections.append(
                parent_connection
            )
            self.processes.append(
                process
            )

    def _receive(self, worker_index: int):
        try:
            status, payload = (
                self.connections[
                    worker_index
                ].recv()
            )
        except EOFError as error:
            process = self.processes[
                worker_index
            ]
            raise RuntimeError(
                f"HeMAC worker {worker_index} exited "
                f"unexpectedly with exit code "
                f"{process.exitcode}."
            ) from error

        if status == "error":
            raise RuntimeError(
                f"HeMAC worker {worker_index} failed:\n"
                f"{payload}"
            )

        if status != "ok":
            raise RuntimeError(
                f"Unexpected worker status: {status!r}"
            )

        return payload

    def reset(
        self,
        worker_indices,
        seeds,
        fresh: bool = False,
    ):
        if len(worker_indices) != len(seeds):
            raise ValueError(
                "worker_indices and seeds must match"
            )

        for worker_index, seed in zip(
            worker_indices,
            seeds,
        ):
            self.connections[
                worker_index
            ].send(
                (
                    (
                        "reset_fresh"
                        if fresh
                        else "reset"
                    ),
                    int(seed),
                )
            )

        return [
            self._receive(worker_index)
            for worker_index in worker_indices
        ]

    def step(
        self,
        worker_indices,
        actions,
    ):
        if len(worker_indices) != len(actions):
            raise ValueError(
                "worker_indices and actions must match"
            )

        # Send every action first. This is what allows all
        # environment workers to execute simultaneously.
        for worker_index, action in zip(
            worker_indices,
            actions,
        ):
            self.connections[
                worker_index
            ].send(
                (
                    "step",
                    np.ascontiguousarray(
                        action,
                        dtype=np.float32,
                    ),
                )
            )

        # Then wait for all workers.
        return [
            self._receive(worker_index)
            for worker_index in worker_indices
        ]

    def close(self):
        for connection in self.connections:
            try:
                connection.send(
                    ("close", None)
                )
            except (
                BrokenPipeError,
                EOFError,
                OSError,
            ):
                pass

        for connection in self.connections:
            try:
                connection.close()
            except OSError:
                pass

        for process in self.processes:
            process.join(timeout=2.0)

            if process.is_alive():
                process.terminate()
                process.join(timeout=2.0)


def rollout_episodes_multiprocess(
    *,
    worker_pool: HeMACWorkerPool,
    seeds,
    model,
    no_skill_policy: OnlineSkillConditionedResidualPolicy,
    value_head: OnlineValueHead,
    anchor_head: nn.Module,
    anchor_context_adapter: nn.Module | None,
    use_pretrained_value: bool,
    credit_assignment: str,
    log_std: torch.Tensor,
    action_scale: float,
    reward_scale: float,
    shared_terminal_crash_penalty: float,
    success_min_coverage_ratio: float,
    device: torch.device,
    stochastic: bool,
    skill_mode: str,
):
    """CPU-parallel env rollout with one batched GPU inference process."""
    if use_pretrained_value:
        raise ValueError(
            "Multiprocess rollout currently requires "
            "--no-use-pretrained-value."
        )

    if credit_assignment != "agent":
        raise ValueError(
            "Multiprocess rollout currently requires "
            "--credit-assignment agent."
        )

    batch_size = len(seeds)

    if batch_size == 0:
        return [], []

    worker_indices = list(
        range(batch_size)
    )

    reset_results = worker_pool.reset(
        worker_indices,
        seeds,
    )

    drone_count = reset_results[0][
        "drone_count"
    ]

    if any(
        result["drone_count"]
        != drone_count
        for result in reset_results
    ):
        raise RuntimeError(
            "Worker drone counts differ."
        )

    slots = []

    for worker_index, result in zip(
        worker_indices,
        reset_results,
    ):
        slots.append(
            {
                "worker_index": worker_index,
                "packet": result["packet"],
                "recurrent_state": (
                    model.initial_inference_state(
                        device=device
                    )
                ),
                "transitions": [],
                "done": False,
                "metrics": None,
            }
        )

    while True:
        active_slots = [
            slot
            for slot in slots
            if not slot["done"]
        ]

        if not active_slots:
            break

        # ----------------------------------------------------
        # CPU workers already prepared these observations
        # concurrently. Concatenate and transfer once.
        # ----------------------------------------------------
        observation_keys = (
            active_slots[0]["packet"][
                "observations"
            ].keys()
        )

        observations = {}

        for key in observation_keys:
            array = np.concatenate(
                [
                    slot["packet"][
                        "observations"
                    ][key]
                    for slot in active_slots
                ],
                axis=0,
            )

            observations[key] = (
                torch.from_numpy(
                    np.ascontiguousarray(
                        array
                    )
                ).to(device)
            )

        # Match drone_observation_batch exactly:
        # raw tensor -> target device -> divide on that device.
        observations["action_history"] = (
            observations["action_history"]
            / action_scale
        )

        central_map_array = np.stack(
            [
                slot["packet"][
                    "central_map"
                ]
                for slot in active_slots
            ],
            axis=0,
        )

        central_map = torch.from_numpy(
            np.ascontiguousarray(
                central_map_array
            )
        ).to(device)

        valid_mask = torch.ones(
            len(active_slots),
            drone_count,
            dtype=torch.bool,
            device=device,
        )

        recurrent_state = (
            _batch_rollout_state(
                [
                    slot["recurrent_state"]
                    for slot in active_slots
                ]
            )
        )

        with torch.no_grad():
            (
                outputs,
                next_recurrent_state,
            ) = model.inference_step(
                observations,
                valid_mask,
                recurrent_state,
            )

            task_skill = outputs[
                "task_skills"
            ]
            observation_features = outputs[
                "observation_features"
            ]
            common_skills = outputs[
                "common_skills"
            ]

            task_context = (
                next_recurrent_state[
                    "task_context"
                ]
            )

            context_adapter = (
                getattr(
                    model.task_skill_encoder,
                    "context_adapter",
                    None,
                )
                if model.skill_structure
                in {"split", "task_only"}
                else None
            )

            if skill_mode == "no_skill":
                task_base_skill = task_skill
                anchor_task_skill = task_skill

            elif context_adapter is None:
                task_base_skill = task_skill
                anchor_task_skill = task_skill

            else:
                task_base_skill = (
                    task_skill
                    - context_adapter(
                        task_context
                    ).unsqueeze(1)
                )

                anchor_task_skill = (
                    task_base_skill
                    + anchor_context_adapter(
                        task_context
                    ).unsqueeze(1)
                )

            (
                action_mean,
                _,
                base_action,
            ) = online_action_mean(
                model,
                no_skill_policy,
                observation_features,
                common_skills,
                task_skill,
                skill_mode,
                action_scale,
                compute_skill_delta=False,
            )

            anchor_action_mean = (
                base_action
            )

            stored_common_skills = (
                common_skills
            )
            stored_task_skill = (
                task_skill
            )

            if skill_mode == "no_skill":
                stored_common_skills = (
                    torch.zeros_like(
                        common_skills
                    )
                )
                stored_task_skill = (
                    torch.zeros_like(
                        task_skill
                    )
                )

            central_embedding = (
                model.central_state_encoder(
                    central_map
                )
            )

            central_per_drone = (
                central_embedding
                .unsqueeze(1)
                .expand(
                    -1,
                    drone_count,
                    -1,
                )
            )

            critic_features = torch.cat(
                (
                    observation_features,
                    stored_common_skills,
                    stored_task_skill,
                    central_per_drone,
                ),
                dim=-1,
            )

            pretrained_value = (
                central_embedding.new_zeros(
                    (
                        len(active_slots),
                        drone_count,
                    )
                )
            )

            value = (
                pretrained_value
                + value_head(
                    critic_features
                )
            )

            distribution = (
                environment_action_distribution(
                    action_mean,
                    log_std,
                    action_scale,
                )
            )

            raw_action = (
                distribution.sample()
                if stochastic
                else action_mean
            )

            old_log_prob = (
                per_drone_gaussian_log_prob(
                    distribution,
                    raw_action,
                )
            )

        raw_action_cpu = (
            raw_action
            .detach()
            .cpu()
            .numpy()
        )

        # Save the state/action side before workers advance.
        for batch_index, slot in enumerate(
            active_slots
        ):
            slot["recurrent_state"] = (
                _slice_rollout_state(
                    next_recurrent_state,
                    batch_index,
                )
            )

            if stochastic:
                slot["transitions"].append(
                    {
                        "global_map": observations[
                            "global_map"
                        ][batch_index].detach(),
                        "local_map": observations[
                            "local_map"
                        ][batch_index].detach(),
                        "action_history": observations[
                            "action_history"
                        ][batch_index].detach(),
                        "task_skill": stored_task_skill[
                            batch_index
                        ].detach(),
                        "task_base_skill": task_base_skill[
                            batch_index
                        ].detach(),
                        "task_context": task_context[
                            batch_index
                        ].detach(),
                        "anchor_task_skill": anchor_task_skill[
                            batch_index
                        ].detach(),
                        "observation_features": (
                            observation_features[
                                batch_index
                            ].detach()
                        ),
                        "common_skills": stored_common_skills[
                            batch_index
                        ].detach(),
                        "anchor_action_mean": (
                            anchor_action_mean[
                                batch_index
                            ].detach()
                        ),
                        "raw_action": raw_action[
                            batch_index
                        ].detach(),
                        "old_log_prob": old_log_prob[
                            batch_index
                        ].detach(),
                        "critic_features": critic_features[
                            batch_index
                        ].detach(),
                        "pretrained_value": pretrained_value[
                            batch_index
                        ].detach(),
                        "value": value[
                            batch_index
                        ].detach(),
                    }
                )

        active_worker_indices = [
            slot["worker_index"]
            for slot in active_slots
        ]

        # All env.step + next-observation work now happens
        # concurrently across CPU worker processes.
        step_results = worker_pool.step(
            active_worker_indices,
            raw_action_cpu,
        )

        for slot, result in zip(
            active_slots,
            step_results,
        ):
            if stochastic:
                transition = (
                    slot["transitions"][-1]
                )

                transition["agent_mask"] = (
                    torch.from_numpy(
                        result[
                            "agent_mask"
                        ].copy()
                    )
                )

                transition["reward"] = (
                    torch.from_numpy(
                        result[
                            "reward"
                        ].copy()
                    )
                )

            if result["done"]:
                slot["done"] = True
                slot["metrics"] = (
                    result["metrics"]
                )
                slot["packet"] = None
            else:
                slot["packet"] = (
                    result["packet"]
                )

    episodes = [
        slot["transitions"]
        for slot in slots
    ]

    metrics = [
        slot["metrics"]
        for slot in slots
    ]

    if any(
        metric is None
        for metric in metrics
    ):
        raise RuntimeError(
            "A worker episode ended without metrics."
        )

    return episodes, metrics


def rollout_episodes_batched(
    *,
    envs,
    seeds,
    model,
    no_skill_policy: OnlineSkillConditionedResidualPolicy,
    value_head: OnlineValueHead,
    anchor_head: nn.Module,
    anchor_context_adapter: nn.Module | None,
    use_pretrained_value: bool,
    credit_assignment: str,
    log_std: torch.Tensor,
    action_scale: float,
    reward_scale: float,
    shared_terminal_crash_penalty: float,
    success_min_coverage_ratio: float,
    device: torch.device,
    stochastic: bool,
    skill_mode: str,
    worker_pool=None,
):
    """Run independent HeMAC episodes with batched neural inference.

    Environment dynamics, rewards, terminal handling, and GAE remain
    independent per environment. Only neural policy/value inference is
    combined across currently active environments.
    """
    if worker_pool is not None:
        return rollout_episodes_multiprocess(
            worker_pool=worker_pool,
            seeds=seeds,
            model=model,
            no_skill_policy=no_skill_policy,
            value_head=value_head,
            anchor_head=anchor_head,
            anchor_context_adapter=anchor_context_adapter,
            use_pretrained_value=use_pretrained_value,
            credit_assignment=credit_assignment,
            log_std=log_std,
            action_scale=action_scale,
            reward_scale=reward_scale,
            shared_terminal_crash_penalty=shared_terminal_crash_penalty,
            success_min_coverage_ratio=success_min_coverage_ratio,
            device=device,
            stochastic=stochastic,
            skill_mode=skill_mode,
        )

    if len(envs) != len(seeds):
        raise ValueError("envs and seeds must have equal lengths")

    if not envs:
        return [], []

    # Keep the first implementation narrow so it exactly matches the
    # configuration used by the HiSSD learning-efficiency experiment.
    if use_pretrained_value:
        raise ValueError(
            "--rollout-envs > 1 currently requires "
            "--no-use-pretrained-value"
        )

    if credit_assignment != "agent":
        raise ValueError(
            "--rollout-envs > 1 currently requires "
            "--credit-assignment agent"
        )

    slots = []

    for env, seed in zip(envs, seeds):
        env.reset(seed=seed)

        core_env = get_core_env(env)
        agent_order = list(env.possible_agents)
        drone_ids = [
            agent_id
            for agent_id in agent_order
            if agent_id.startswith("drone_")
        ]

        if len(drone_ids) != len(agent_order):
            raise ValueError(
                "Drone-only fine-tuning received a non-drone agent"
            )

        slots.append(
            {
                "env": env,
                "core_env": core_env,
                "agent_order": agent_order,
                "drone_ids": drone_ids,
                "drone_index": {
                    drone_id: index
                    for index, drone_id in enumerate(drone_ids)
                },
                "drone_indices": list(range(len(drone_ids))),
                "last_agent_id": agent_order[-1],
                "recurrent_state": model.initial_inference_state(
                    device=device
                ),
                "transitions": [],
                "cycle_count": 0,
                "episode_return": 0.0,
                "done": False,
            }
        )

    while True:
        active_slots = [
            slot for slot in slots
            if not slot["done"]
        ]

        if not active_slots:
            break

        drone_count = len(active_slots[0]["drone_ids"])

        if any(
            len(slot["drone_ids"]) != drone_count
            for slot in active_slots
        ):
            raise RuntimeError(
                "All batched environments must have the same drone count"
            )

        # ----------------------------------------------------
        # Build observations independently on CPU.
        # ----------------------------------------------------
        observation_items = [
            drone_observation_batch(
                slot["env"],
                slot["drone_ids"],
                action_scale,
                device,
            )
            for slot in active_slots
        ]

        observations = _batch_rollout_observations(
            observation_items
        )

        valid_mask = torch.ones(
            len(active_slots),
            drone_count,
            dtype=torch.bool,
            device=device,
        )

        recurrent_state = _batch_rollout_state(
            [
                slot["recurrent_state"]
                for slot in active_slots
            ]
        )

        # ----------------------------------------------------
        # One neural inference call for all active envs.
        # ----------------------------------------------------
        with torch.no_grad():
            outputs, next_recurrent_state = model.inference_step(
                observations,
                valid_mask,
                recurrent_state,
            )

            task_skill = outputs["task_skills"]
            observation_features = outputs[
                "observation_features"
            ]
            common_skills = outputs["common_skills"]

            task_context = next_recurrent_state[
                "task_context"
            ]

            context_adapter = (
                getattr(
                    model.task_skill_encoder,
                    "context_adapter",
                    None,
                )
                if model.skill_structure
                in {"split", "task_only"}
                else None
            )

            if skill_mode == "no_skill":
                task_base_skill = task_skill
                anchor_task_skill = task_skill

            elif context_adapter is None:
                task_base_skill = task_skill
                anchor_task_skill = task_skill

            else:
                task_base_skill = (
                    task_skill
                    - context_adapter(
                        task_context
                    ).unsqueeze(1)
                )

                anchor_task_skill = (
                    task_base_skill
                    + anchor_context_adapter(
                        task_context
                    ).unsqueeze(1)
                )

            (
                action_mean,
                _,
                base_action,
            ) = online_action_mean(
                model,
                no_skill_policy,
                observation_features,
                common_skills,
                task_skill,
                skill_mode,
                action_scale,
                compute_skill_delta=False,
            )

            anchor_action_mean = base_action

            # Match original rollout semantics: zero the stored
            # skill representation only after action computation.
            stored_common_skills = common_skills
            stored_task_skill = task_skill

            if skill_mode == "no_skill":
                stored_common_skills = torch.zeros_like(
                    common_skills
                )
                stored_task_skill = torch.zeros_like(
                    task_skill
                )

            # Central critic encoding is batched as well.
            central_maps = np.stack(
                [
                    build_global_central_map(
                        slot["core_env"]
                    )
                    for slot in active_slots
                ],
                axis=0,
            )

            central_map = torch.from_numpy(
                central_maps
            ).to(device)

            central_embedding = (
                model.central_state_encoder(
                    central_map
                )
            )

            central_per_drone = (
                central_embedding
                .unsqueeze(1)
                .expand(
                    -1,
                    drone_count,
                    -1,
                )
            )

            critic_features = torch.cat(
                (
                    observation_features,
                    stored_common_skills,
                    stored_task_skill,
                    central_per_drone,
                ),
                dim=-1,
            )

            pretrained_value = (
                central_embedding.new_zeros(
                    (
                        len(active_slots),
                        drone_count,
                    )
                )
            )

            value = (
                pretrained_value
                + value_head(critic_features)
            )

            distribution = (
                environment_action_distribution(
                    action_mean,
                    log_std,
                    action_scale,
                )
            )

            raw_action = (
                distribution.sample()
                if stochastic
                else action_mean
            )

            old_log_prob = (
                per_drone_gaussian_log_prob(
                    distribution,
                    raw_action,
                )
            )

        # One D2H copy for all active environments.
        raw_action_cpu = (
            raw_action
            .detach()
            .cpu()
            .numpy()
        )

        # ----------------------------------------------------
        # Step one complete PettingZoo world-cycle/env.
        # ----------------------------------------------------
        for batch_index, slot in enumerate(active_slots):
            slot["recurrent_state"] = (
                _slice_rollout_state(
                    next_recurrent_state,
                    batch_index,
                )
            )

            env = slot["env"]
            core_env = slot["core_env"]
            drone_ids = slot["drone_ids"]

            cached_actions = {}

            for drone_index, drone_id in enumerate(drone_ids):
                action_space = env.action_space(drone_id)

                action = raw_action_cpu[
                    batch_index,
                    drone_index,
                ]

                cached_actions[drone_id] = (
                    np.ascontiguousarray(
                        np.clip(
                            action,
                            action_space.low,
                            action_space.high,
                        ),
                        dtype=np.float32,
                    )
                )

            if stochastic:
                slot["transitions"].append(
                    {
                        "global_map": observations[
                            "global_map"
                        ][batch_index].detach(),
                        "local_map": observations[
                            "local_map"
                        ][batch_index].detach(),
                        "action_history": observations[
                            "action_history"
                        ][batch_index].detach(),
                        "task_skill": stored_task_skill[
                            batch_index
                        ].detach(),
                        "task_base_skill": task_base_skill[
                            batch_index
                        ].detach(),
                        "task_context": task_context[
                            batch_index
                        ].detach(),
                        "anchor_task_skill": anchor_task_skill[
                            batch_index
                        ].detach(),
                        "observation_features": (
                            observation_features[
                                batch_index
                            ].detach()
                        ),
                        "common_skills": stored_common_skills[
                            batch_index
                        ].detach(),
                        "anchor_action_mean": (
                            anchor_action_mean[
                                batch_index
                            ].detach()
                        ),
                        "raw_action": raw_action[
                            batch_index
                        ].detach(),
                        "old_log_prob": old_log_prob[
                            batch_index
                        ].detach(),
                        "critic_features": critic_features[
                            batch_index
                        ].detach(),
                        "pretrained_value": pretrained_value[
                            batch_index
                        ].detach(),
                        "value": value[
                            batch_index
                        ].detach(),
                    }
                )

            cycle_rewards = np.zeros(
                len(slot["agent_order"]),
                dtype=np.float32,
            )

            distributed_success_rewards = np.zeros(
                len(slot["agent_order"]),
                dtype=np.float32,
            )

            cycle_mask = np.zeros(
                len(slot["agent_order"]),
                dtype=np.bool_,
            )

            shared_success_reward = 0.0

            while True:
                agent_id = env.agent_selection

                (
                    _,
                    _,
                    termination,
                    truncation,
                    _,
                ) = env.last()

                if termination or truncation:
                    env.step(None)

                    if not env.agents:
                        slot["done"] = True
                        break

                    continue

                index = slot["drone_index"][agent_id]
                cycle_mask[index] = True

                env.step(
                    cached_actions[agent_id]
                )

                for (
                    reward_index,
                    reward_agent_id,
                ) in enumerate(drone_ids):
                    cycle_rewards[
                        reward_index
                    ] += _local_reward_after_step(
                        core_env,
                        reward_agent_id,
                    )

                shared_success_reward = max(
                    shared_success_reward,
                    float(core_env.global_reward),
                )

                for (
                    reward_index,
                    reward_agent_id,
                ) in enumerate(drone_ids):
                    distributed_success_rewards[
                        reward_index
                    ] = max(
                        distributed_success_rewards[
                            reward_index
                        ],
                        float(
                            core_env._global_reward_for_agent(
                                reward_agent_id
                            )
                        ),
                    )

                cycle_finished = (
                    agent_id
                    == slot["last_agent_id"]
                    or bool(core_env.terminate)
                    or bool(core_env.truncate)
                )

                if cycle_finished:
                    break

            # Should only occur while draining a terminal env.
            if slot["done"]:
                continue

            cycle_rewards = (
                apply_shared_terminal_crash_penalty(
                    cycle_rewards,
                    fatal_crash=bool(
                        core_env.collided
                    ),
                    penalty=(
                        shared_terminal_crash_penalty
                    ),
                )
            )

            team_reward = _team_reward(
                cycle_rewards,
                cycle_mask,
                [],
                slot["drone_indices"],
                shared_success_reward,
            )

            slot["episode_return"] += float(
                team_reward
            )

            if stochastic:
                transition = slot["transitions"][-1]

                transition["agent_mask"] = (
                    torch.from_numpy(
                        cycle_mask.copy()
                    )
                )

                per_drone_reward = (
                    combine_per_drone_rewards(
                        cycle_rewards,
                        distributed_success_rewards,
                    )
                )

                transition["reward"] = (
                    torch.from_numpy(
                        per_drone_reward
                        / reward_scale
                    )
                )

            slot["cycle_count"] += 1

            if (
                bool(core_env.terminate)
                or bool(core_env.truncate)
            ):
                # Match the AEC iterator's terminal cleanup.
                while env.agents:
                    (
                        _,
                        _,
                        termination,
                        truncation,
                        _,
                    ) = env.last()

                    if not (
                        termination
                        or truncation
                    ):
                        break

                    env.step(None)

                slot["done"] = True

    episodes = [
        slot["transitions"]
        for slot in slots
    ]

    metrics = [
        _batched_episode_metrics(slot)
        for slot in slots
    ]

    return episodes, metrics


def ppo_update(
    model,
    no_skill_policy: OnlineNoSkillResidualPolicy,
    value_head: OnlineValueHead,
    log_std: nn.Parameter,
    optimizer: torch.optim.Optimizer,
    transitions: list[dict[str, Any]],
    args: argparse.Namespace,
    device: torch.device,
    *,
    action_scale: float,
    adapt_context: bool,
    adapt_base_head: bool,
    adapt_encoder: bool,
    skill_mode: str,
) -> dict[str, float]:
    if not transitions:
        raise RuntimeError("No drone PPO transitions were collected.")
    data = {
        key: torch.stack([transition[key] for transition in transitions]).to(device)
        for key in (
            "global_map",
            "local_map",
            "action_history",
            "task_skill",
            "task_base_skill",
            "task_context",
            "anchor_task_skill",
            "observation_features",
            "common_skills",
            "anchor_action_mean",
            "raw_action",
            "old_log_prob",
            "agent_mask",
            "critic_features",
            "pretrained_value",
        )
    }
    advantages = torch.stack(
        [torch.as_tensor(transition["advantage"]) for transition in transitions]
    ).to(device=device, dtype=torch.float32)
    returns = torch.stack(
        [torch.as_tensor(transition["return"]) for transition in transitions]
    ).to(device=device, dtype=torch.float32)
    agent_mask = data["agent_mask"].bool()
    if advantages.ndim == 2:
        valid_advantages = advantages[agent_mask]
        normalized = (advantages - valid_advantages.mean()) / valid_advantages.std(
            unbiased=False
        ).clamp_min(1e-6)
        advantages = torch.where(agent_mask, normalized, 0.0)
    else:
        advantages = (advantages - advantages.mean()) / advantages.std(
            unbiased=False
        ).clamp_min(1e-6)
    transition_count = len(transitions)
    accumulator: dict[str, torch.Tensor] = {}
    updates = 0

    def accumulate(name: str, value: torch.Tensor) -> None:
        value = value.detach()
        if name in accumulator:
            accumulator[name] = accumulator[name] + value
        else:
            accumulator[name] = value
    stopped_for_kl = False
    maximum_observed_kl = 0.0
    task_head = model.action_decoder.task_action_residual_head

    # Constant throughout this PPO update. Avoid recomputing it and forcing
    # a CUDA->CPU synchronization for every minibatch.
    initial_gate = (
        float(
            no_skill_policy.initial_skill_prior_gate
            .abs()
            .mean()
            .detach()
        )
        if skill_mode == "full"
        else 0.0
    )

    context_adapter = (
        getattr(model.task_skill_encoder, "context_adapter", None)
        if model.skill_structure in {"split", "task_only"}
        else None
    )
    for _ in range(args.ppo_epochs):
        permutation = torch.randperm(transition_count, device=device)
        for start in range(0, transition_count, args.minibatch_size):
            indices = permutation[start : start + args.minibatch_size]
            if skill_mode == "no_skill":
                task_skill = torch.zeros_like(data["task_skill"][indices])
            elif adapt_context and context_adapter is not None:
                task_skill = data["task_base_skill"][indices] + context_adapter(
                    data["task_context"][indices]
                ).unsqueeze(1)
            else:
                task_skill = data["task_skill"][indices]
            if adapt_encoder:
                observation_features = model.observation_encoder(
                    data["global_map"][indices],
                    data["local_map"][indices],
                    data["action_history"][indices],
                )
            else:
                observation_features = data["observation_features"][indices]
            action_mean, skill_action_delta, _ = online_action_mean(
                model,
                no_skill_policy,
                observation_features,
                data["common_skills"][indices],
                task_skill,
                skill_mode,
                action_scale,
            )
            distribution = environment_action_distribution(
                action_mean, log_std, action_scale
            )
            log_prob = per_drone_gaussian_log_prob(
                distribution, data["raw_action"][indices]
            )
            ratio = torch.exp(log_prob - data["old_log_prob"][indices])
            advantage = advantages[indices]
            if advantage.ndim == 1:
                advantage = advantage.unsqueeze(-1)
            unclipped = ratio * advantage
            clipped = ratio.clamp(
                1.0 - args.clip_ratio, 1.0 + args.clip_ratio
            ) * advantage
            minibatch_mask = agent_mask[indices]
            surrogate = torch.minimum(unclipped, clipped)
            policy_loss = -surrogate[minibatch_mask].mean()
            approx_kl = (
                data["old_log_prob"][indices] - log_prob
            )[minibatch_mask].mean()
            observed_kl = float(approx_kl.detach())
            maximum_observed_kl = max(maximum_observed_kl, observed_kl)
            if updates > 0 and observed_kl > args.target_kl:
                stopped_for_kl = True
                break
            value = data["pretrained_value"][indices] + value_head(
                data["critic_features"][indices]
            )
            if value.ndim == 2:
                value_loss = F.mse_loss(
                    value[minibatch_mask], returns[indices][minibatch_mask]
                )
            else:
                value_loss = F.mse_loss(value, returns[indices])
            entropy_by_agent = distribution.entropy().sum(dim=-1)
            entropy = entropy_by_agent[minibatch_mask].mean()
            action_mask = minibatch_mask.unsqueeze(-1).expand_as(action_mean)
            anchor_error = (
                action_mean - data["anchor_action_mean"][indices]
            ).square()
            anchor_loss = anchor_error[action_mask].mean()
            if skill_mode == "full":
                skill_mask = minibatch_mask.unsqueeze(-1).expand_as(task_skill)
                skill_anchor_loss = (
                    task_skill - data["anchor_task_skill"][indices]
                ).square()[skill_mask].mean()
            else:
                skill_anchor_loss = action_mean.new_zeros(())
            loss = (
                policy_loss
                + args.value_coeff * value_loss
                - args.entropy_coeff * entropy
                + args.anchor_coeff * anchor_loss
                + args.skill_anchor_coeff * skill_anchor_loss
            )
            optimizer.zero_grad(set_to_none=True)
            loss.backward()
            actor_parameters = list(no_skill_policy.parameters())
            if adapt_base_head:
                actor_parameters.extend(model.action_decoder.base_action_head.parameters())
            if adapt_encoder:
                actor_parameters.extend(
                    final_fusion_linear(model.observation_encoder).parameters()
                )
            if skill_mode == "full" and adapt_context and context_adapter is not None:
                actor_parameters.extend(context_adapter.parameters())
            grad_norm = torch.nn.utils.clip_grad_norm_(
                [*actor_parameters, *value_head.parameters(), log_std],
                args.max_grad_norm,
            )
            optimizer.step()
            with torch.no_grad():
                log_std.clamp_(args.log_std_min, args.log_std_max)
            accumulate("policy_loss", policy_loss)
            accumulate("value_loss", value_loss)
            accumulate("entropy", entropy)
            accumulate("anchor_loss", anchor_loss)
            accumulate("skill_anchor_loss", skill_anchor_loss)
            accumulate("skill_action_delta", skill_action_delta)
            with torch.no_grad():
                current_skill_gate = (
                    no_skill_policy.skill_prior_fraction(
                        observation_features,
                        data["common_skills"][indices],
                        task_skill,
                    )
                    if skill_mode == "full"
                    else action_mean.new_zeros(())
                )
            gate_abs_mean = current_skill_gate.abs().mean()
            gate_mean = current_skill_gate.mean()

            accumulate("skill_prior_gate", gate_abs_mean)
            accumulate("skill_prior_gate_signed", gate_mean)

            if skill_mode == "full" and initial_gate > 0.0:
                accumulate(
                    "skill_prior_retention",
                    gate_abs_mean / max(initial_gate, 1e-8),
                )
            else:
                accumulate(
                    "skill_prior_retention",
                    action_mean.new_zeros(()),
                )

            accumulate("approx_kl", approx_kl)

            clip_fraction = (
                ((ratio - 1.0).abs() > args.clip_ratio)[minibatch_mask]
                .float()
                .mean()
            )
            accumulate("clip_fraction", clip_fraction)
            accumulate("grad_norm", grad_norm)
            updates += 1
        if stopped_for_kl:
            break
    metrics = {
        name: float((value / max(updates, 1)).detach())
        for name, value in accumulator.items()
    }
    metrics["early_stop_kl"] = float(stopped_for_kl)
    metrics["max_approx_kl"] = maximum_observed_kl
    metrics["base_head_active"] = float(adapt_base_head)
    metrics["encoder_active"] = float(adapt_encoder)
    return metrics


def evaluation_score(metrics: dict[str, float]) -> float:
    return metrics["success"] + 0.10 * metrics["goal_found"] - 0.25 * metrics["fatal_crash"]


def validation_regressed(
    current_score: float,
    best_score: float,
    rollback_score_drop: float,
) -> bool:
    """Return whether a fixed-seed validation drop warrants safe rollback."""
    return bool(
        rollback_score_drop > 0.0
        and current_score < best_score - rollback_score_drop
    )



def rollout_episodes_multiprocess_eval_exact(
    *,
    worker_pool,
    seeds,
    model,
    no_skill_policy,
    value_head,
    anchor_head,
    anchor_context_adapter,
    use_pretrained_value,
    credit_assignment,
    log_std,
    action_scale,
    reward_scale,
    shared_terminal_crash_penalty,
    success_min_coverage_ratio,
    device,
    stochastic,
    skill_mode,
):
    """Parallel CPU environments with original batch=1 eval inference.

    Environment stepping runs concurrently in worker processes, but every
    policy forward keeps the same batch shape as rollout_episode(). This
    avoids changing deterministic validation trajectories merely because
    evaluation uses a different neural-network batch size.
    """
    if stochastic:
        raise ValueError(
            "Exact multiprocess evaluation requires stochastic=False."
        )

    if use_pretrained_value:
        raise ValueError(
            "Exact multiprocess evaluation currently requires "
            "--no-use-pretrained-value."
        )

    if credit_assignment != "agent":
        raise ValueError(
            "Exact multiprocess evaluation currently requires "
            "--credit-assignment agent."
        )

    batch_size = len(seeds)

    if batch_size == 0:
        return [], []

    worker_indices = list(range(batch_size))

    reset_results = worker_pool.reset(
        worker_indices,
        seeds,
        fresh=True,
    )

    drone_count = reset_results[0]["drone_count"]

    if any(
        result["drone_count"] != drone_count
        for result in reset_results
    ):
        raise RuntimeError(
            "Evaluation worker drone counts differ."
        )

    slots = []

    for worker_index, result in zip(
        worker_indices,
        reset_results,
    ):
        slots.append(
            {
                "worker_index": worker_index,
                "packet": result["packet"],
                "recurrent_state": (
                    model.initial_inference_state(
                        device=device
                    )
                ),
                "done": False,
                "metrics": None,
            }
        )

    valid_mask = torch.ones(
        1,
        drone_count,
        dtype=torch.bool,
        device=device,
    )

    while True:
        active_slots = [
            slot
            for slot in slots
            if not slot["done"]
        ]

        if not active_slots:
            break

        worker_ids = []
        actions = []

        # IMPORTANT:
        # Do NOT batch neural inference here.
        # Each forward uses exactly [1, drones, ...],
        # matching rollout_episode().
        for slot in active_slots:
            packet = slot["packet"]

            observations = {
                key: torch.from_numpy(
                    np.ascontiguousarray(value)
                ).to(device)
                for key, value
                in packet["observations"].items()
            }

            # Canonical CUDA observation semantics.
            observations["action_history"] = (
                observations["action_history"]
                / action_scale
            )

            with torch.no_grad():
                outputs, next_state = (
                    model.inference_step(
                        observations,
                        valid_mask,
                        slot["recurrent_state"],
                    )
                )

                # Exactly match rollout_episode's indexing.
                task_skill = outputs[
                    "task_skills"
                ][0]

                observation_features = outputs[
                    "observation_features"
                ][0]

                common_skills = outputs[
                    "common_skills"
                ][0]

                task_context = next_state[
                    "task_context"
                ][0]

                context_adapter = (
                    getattr(
                        model.task_skill_encoder,
                        "context_adapter",
                        None,
                    )
                    if model.skill_structure
                    in {"split", "task_only"}
                    else None
                )

                # Context calculations are retained so the actor
                # follows the same code path as normal rollout.
                if skill_mode == "no_skill":
                    task_base_skill = task_skill
                    anchor_task_skill = task_skill

                elif context_adapter is None:
                    task_base_skill = task_skill
                    anchor_task_skill = task_skill

                else:
                    task_base_skill = (
                        task_skill
                        - context_adapter(
                            task_context
                        ).unsqueeze(0)
                    )

                    anchor_task_skill = (
                        task_base_skill
                        + anchor_context_adapter(
                            task_context
                        ).unsqueeze(0)
                    )

                (
                    action_mean,
                    _,
                    _,
                ) = online_action_mean(
                    model,
                    no_skill_policy,
                    observation_features,
                    common_skills,
                    task_skill,
                    skill_mode,
                    action_scale,
                    compute_skill_delta=False,
                )

                # Original deterministic rollout:
                # raw_action = action_mean
                raw_action = action_mean

            slot["recurrent_state"] = next_state

            worker_ids.append(
                slot["worker_index"]
            )

            actions.append(
                raw_action
                .detach()
                .cpu()
                .numpy()
            )

        # Environment/world work remains parallel.
        step_results = worker_pool.step(
            worker_ids,
            actions,
        )

        for slot, result in zip(
            active_slots,
            step_results,
        ):
            if result["done"]:
                slot["done"] = True
                slot["metrics"] = (
                    result["metrics"]
                )
                slot["packet"] = None
            else:
                slot["packet"] = (
                    result["packet"]
                )

    metrics = [
        slot["metrics"]
        for slot in slots
    ]

    if any(
        metric is None
        for metric in metrics
    ):
        raise RuntimeError(
            "An exact evaluation worker ended "
            "without episode metrics."
        )

    return [], metrics


def evaluate_policy(
    *,
    checkpoint_env_config: dict[str, Any],
    model,
    no_skill_policy,
    value_head,
    anchor_head: nn.Module,
    anchor_context_adapter: nn.Module | None,
    use_pretrained_value: bool,
    log_std: torch.Tensor,
    args: argparse.Namespace,
    device: torch.device,
    seed_base: int | None = None,
    worker_pool=None,
) -> dict[str, float]:
    """Evaluate deterministic policy on the fixed validation seeds.

    When supported, environments execute in parallel CPU workers while
    neural inference remains batched on the main-process GPU.
    """
    config = build_env_config(
        checkpoint_env_config,
        args.difficulty,
        args.success_min_coverage_ratio,
    )

    seed_base = (
        args.seed
        if seed_base is None
        else seed_base
    )

    metrics = []
    success_count = 0.0
    action_scale = drone_action_scale(config)

    parallel_eval = (
        bool(args.multiprocess_rollout)
        and int(args.eval_envs) > 1
        and int(args.eval_episodes) > 1
        and not use_pretrained_value
        and args.credit_assignment == "agent"
    )

    progress = (
        tqdm(
            total=args.eval_episodes,
            desc=(
                f"eval {args.skill_mode} "
                f"D{args.difficulty}"
            ),
            unit="episode",
            dynamic_ncols=True,
            leave=False,
            mininterval=0.5,
            file=sys.stdout,
        )
        if tqdm is not None
        else None
    )

    try:
        if parallel_eval:
            eval_env_count = min(
                int(args.eval_envs),
                int(args.eval_episodes),
            )

            # Periodic validation can reuse the already-running
            # training worker pool. Baseline/eval-only evaluation
            # creates a temporary pool and closes it afterward.
            owned_worker_pool = None

            if worker_pool is None:
                owned_worker_pool = HeMACWorkerPool(
                    num_workers=eval_env_count,
                    config=config,
                    action_scale=action_scale,
                    reward_scale=args.reward_scale,
                    shared_terminal_crash_penalty=(
                        args.shared_terminal_crash_penalty
                    ),
                )
                active_worker_pool = owned_worker_pool
            else:
                active_worker_pool = worker_pool

            try:
                for wave_start in range(
                    0,
                    args.eval_episodes,
                    eval_env_count,
                ):
                    wave_size = min(
                        eval_env_count,
                        args.eval_episodes
                        - wave_start,
                    )

                    # Exact same validation seed sequence as the
                    # original sequential evaluation.
                    seeds = [
                        (
                            seed_base
                            + args.difficulty
                            * 1_000_000
                            + episode_index
                        )
                        for episode_index in range(
                            wave_start,
                            wave_start + wave_size,
                        )
                    ]

                    _, wave_metrics = (
                        rollout_episodes_multiprocess_eval_exact(
                            worker_pool=active_worker_pool,
                            seeds=seeds,
                            model=model,
                            no_skill_policy=no_skill_policy,
                            value_head=value_head,
                            anchor_head=anchor_head,
                            anchor_context_adapter=(
                                anchor_context_adapter
                            ),
                            use_pretrained_value=(
                                use_pretrained_value
                            ),
                            credit_assignment=(
                                args.credit_assignment
                            ),
                            log_std=log_std,
                            action_scale=action_scale,
                            reward_scale=args.reward_scale,
                            shared_terminal_crash_penalty=(
                                args.shared_terminal_crash_penalty
                            ),
                            success_min_coverage_ratio=(
                                args.success_min_coverage_ratio
                            ),
                            device=device,
                            stochastic=False,
                            skill_mode=args.skill_mode,
                        )
                    )

                    metrics.extend(
                        wave_metrics
                    )

                    success_count += sum(
                        result["success"]
                        for result in wave_metrics
                    )

                    if progress is not None:
                        progress.update(
                            len(wave_metrics)
                        )
                        progress.set_postfix(
                            success=(
                                f"{success_count / len(metrics):.3f}"
                            ),
                            envs=wave_size,
                            refresh=False,
                        )

            finally:
                if owned_worker_pool is not None:
                    owned_worker_pool.close()

        else:
            # Canonical evaluation semantics:
            # each validation seed gets a fresh HeMAC environment.
            for episode_index in range(
                args.eval_episodes
            ):
                env = HeMAC_v0.env(**config)

                try:
                    _, result = rollout_episode(
                        env=env,
                        model=model,
                        no_skill_policy=no_skill_policy,
                        value_head=value_head,
                        anchor_head=anchor_head,
                        anchor_context_adapter=(
                            anchor_context_adapter
                        ),
                        use_pretrained_value=(
                            use_pretrained_value
                        ),
                        credit_assignment=(
                            args.credit_assignment
                        ),
                        log_std=log_std,
                        action_scale=action_scale,
                        reward_scale=args.reward_scale,
                        shared_terminal_crash_penalty=(
                            args.shared_terminal_crash_penalty
                        ),
                        success_min_coverage_ratio=(
                            args.success_min_coverage_ratio
                        ),
                        seed=(
                            seed_base
                            + args.difficulty
                            * 1_000_000
                            + episode_index
                        ),
                        device=device,
                        stochastic=False,
                        skill_mode=args.skill_mode,
                    )

                finally:
                    env.close()

                metrics.append(result)
                success_count += result[
                    "success"
                ]

                if progress is not None:
                    progress.update(1)
                    progress.set_postfix(
                        success=(
                            f"{success_count / len(metrics):.3f}"
                        ),
                        envs=1,
                        refresh=False,
                    )

    finally:
        if progress is not None:
            progress.close()

    if len(metrics) != args.eval_episodes:
        raise RuntimeError(
            f"Evaluation returned {len(metrics)} episodes; "
            f"expected {args.eval_episodes}."
        )

    return average_metrics(metrics)



def save_checkpoint(
    path: Path,
    model,
    no_skill_policy: OnlineNoSkillResidualPolicy,
    source_payload: dict[str, Any],
    value_head: OnlineValueHead,
    log_std: nn.Parameter,
    optimizer: torch.optim.Optimizer,
    *,
    iteration: int,
    joint_env_steps: int,
    metrics: dict[str, float],
    args: argparse.Namespace,
) -> None:
    payload = dict(source_payload)
    payload.update(
        {
            "model_config": model.config(),
            "model_state_dict": model.state_dict(),
            "online_skill_conditioned_policy_state_dict": no_skill_policy.state_dict(),
            "online_no_skill_policy_state_dict": no_skill_policy.state_dict(),
            "online_value_state_dict": value_head.state_dict(),
            "online_drone_log_std": log_std.detach().cpu(),
            "online_finetuning": {
                "method": "matched_skill_conditioned_residual_ppo",
                "difficulty": args.difficulty,
                "skill_mode": args.skill_mode,
                "success_definition": "environment_drone_only_mission_success",
                "success_min_coverage_ratio": args.success_min_coverage_ratio,
                "iteration": iteration,
                "joint_env_steps": joint_env_steps,
                "metrics": metrics,
                "hyperparameters": vars(args),
            },
            "online_optimizer_state_dict": optimizer.state_dict(),
        }
    )
    path.parent.mkdir(parents=True, exist_ok=True)
    torch.save(payload, path)


def curve_point(
    args: argparse.Namespace,
    metrics: dict[str, float],
    joint_env_steps: int,
    iteration: int,
    scheduled_joint_env_steps: int | None = None,
    update_metrics: dict[str, float] | None = None,
    train_metrics: dict[str, float] | None = None,
) -> dict[str, Any]:
    reference_agent_count = int(getattr(args, "reference_agent_count", 1))
    rllib_compatible_env_steps = joint_env_steps * reference_agent_count
    point = {
        "method": args.method_name,
        "seed": args.seed,
        "difficulty": args.difficulty,
        "joint_env_steps": joint_env_steps,
        "rllib_compatible_env_steps": rllib_compatible_env_steps,
        "iteration": iteration,
        "ppo_updates": iteration,
        "equivalent_rllib_iterations": rllib_compatible_env_steps / 8_000.0,
        "success_rate": metrics["success"],
        "goal_found_rate": metrics["goal_found"],
        "fatal_crash_rate": metrics["fatal_crash"],
        "drone_crash_rate": metrics["drone_crash"],
        "observer_crash_rate": 0.0,
        "mean_coverage_ratio": metrics["coverage"],
        "mean_drone_reward_coverage_ratio": metrics["reward_coverage"],
        "mean_cycles": metrics["cycles"],
        "mean_episode_return": metrics["episode_return"],
    }
    if scheduled_joint_env_steps is not None:
        point["scheduled_joint_env_steps"] = scheduled_joint_env_steps
    if update_metrics is not None:
        for name in (
            "policy_loss",
            "value_loss",
            "entropy",
            "anchor_loss",
            "skill_anchor_loss",
            "skill_action_delta",
            "skill_prior_gate",
            "skill_prior_gate_signed",
            "skill_prior_retention",
            "early_stop_kl",
            "max_approx_kl",
            "approx_kl",
            "clip_fraction",
            "grad_norm",
            "base_head_active",
            "encoder_active",
        ):
            if name in update_metrics:
                point[f"ppo_{name}"] = float(update_metrics[name])
    if train_metrics is not None:
        point["train_success_rate"] = float(train_metrics["success"])
        point["train_fatal_crash_rate"] = float(train_metrics["fatal_crash"])
        point["train_episode_return"] = float(train_metrics["episode_return"])
    return point


def main() -> None:
    args = parse_args()
    validate_args(args)
    if args.deterministic:
        os.environ.setdefault("CUBLAS_WORKSPACE_CONFIG", ":4096:8")
    seed_everything(args.seed)
    device = resolve_device(args.device)
    configure_backend(device, args.deterministic)
    model, source_payload = load_hissd_model(args.hissd_checkpoint, device)
    online_evaluation_metadata = None
    if args.eval_only:
        online_evaluation_metadata = restore_online_evaluation_settings(
            args, source_payload
        )
        validate_args(args)
    args.reference_agent_count = int(model.agent_count)
    model.enable_task_action_residual()
    for parameter in model.parameters():
        parameter.requires_grad_(False)
    base_action_head = model.action_decoder.base_action_head
    encoder_adaptation_layer = final_fusion_linear(model.observation_encoder)
    task_head = model.action_decoder.task_action_residual_head
    for parameter in task_head.parameters():
        parameter.requires_grad_(False)
    no_skill_policy = OnlineNoSkillResidualPolicy(
        model.observation_encoder.output_dim,
        model.action_dim,
        model.hidden_dim,
        skill_dim=model.skill_dim,
        skill_prior_init=(
            args.skill_prior_init if args.skill_mode == "full" else 0.0
        ),
        skill_prior_max=args.skill_prior_max,
    ).to(device)
    model.eval()
    anchor_head = copy.deepcopy(task_head).to(device).eval()
    for parameter in anchor_head.parameters():
        parameter.requires_grad_(False)
    context_adapter = (
        getattr(model.task_skill_encoder, "context_adapter", None)
        if model.skill_structure in {"split", "task_only"}
        else None
    )
    anchor_context_adapter = None
    if context_adapter is not None:
        anchor_context_adapter = copy.deepcopy(context_adapter).to(device).eval()
        for parameter in anchor_context_adapter.parameters():
            parameter.requires_grad_(False)
        for parameter in context_adapter.parameters():
            parameter.requires_grad_(False)

    resolved_mappo, checkpoint_env_config = load_checkpoint_env_config(
        args.mappo_checkpoint
    )
    critic_input_dim = (
        model.observation_encoder.output_dim + 2 * model.skill_dim + model.hidden_dim
    )
    value_head = OnlineValueHead(critic_input_dim).to(device)
    with torch.no_grad():
        value_head.network[-1].weight.zero_()
        value_head.network[-1].bias.zero_()
    # The actor policy is shared, so its exploration parameters must also be
    # shared rather than learning a separate variance for each drone index.
    log_std = nn.Parameter(
        torch.full((model.action_dim,), args.log_std_init, device=device)
    )
    optimizer_groups = [
        {
            "params": no_skill_policy.observation_network.parameters(),
            "lr": args.actor_lr,
        },
        {"params": base_action_head.parameters(), "lr": args.base_head_lr},
        {"params": encoder_adaptation_layer.parameters(), "lr": args.encoder_lr},
        {"params": value_head.parameters(), "lr": args.critic_lr},
        {"params": [log_std], "lr": args.log_std_lr},
    ]
    if args.skill_mode == "full":
        optimizer_groups.insert(
            1,
            {
                "params": no_skill_policy.skill_gate_network.parameters(),
                "lr": args.skill_gate_lr,
            },
        )
        optimizer_groups.insert(
            2,
            {
                "params": no_skill_policy.skill_network.parameters(),
                "lr": args.skill_residual_lr,
            },
        )
    if context_adapter is not None and args.skill_mode == "full":
        optimizer_groups.insert(
            1, {"params": context_adapter.parameters(), "lr": args.context_lr}
        )
    optimizer = torch.optim.AdamW(
        optimizer_groups,
        weight_decay=1e-5,
    )
    if args.eval_only:
        residual_state = source_payload.get(
            "online_skill_conditioned_policy_state_dict",
            source_payload.get("online_no_skill_policy_state_dict"),
        )
        value_state = source_payload.get("online_value_state_dict")
        saved_log_std = source_payload.get("online_drone_log_std")
        if residual_state is None or value_state is None or saved_log_std is None:
            raise ValueError(
                "Online checkpoint is missing residual policy, value, or log-std state."
            )
        no_skill_policy.load_state_dict(residual_state)
        value_head.load_state_dict(value_state)
        with torch.no_grad():
            log_std.copy_(torch.as_tensor(saved_log_std, device=device))
        model.eval()
        no_skill_policy.eval()
        value_head.eval()
        test_seed_base = (
            args.eval_seed_base
            if args.eval_seed_base is not None
            else 200_000_000
        )
        metrics = evaluate_policy(
            checkpoint_env_config=checkpoint_env_config,
            model=model,
            no_skill_policy=no_skill_policy,
            value_head=value_head,
            anchor_head=anchor_head,
            anchor_context_adapter=anchor_context_adapter,
            use_pretrained_value=args.use_pretrained_value,
            log_std=log_std,
            args=args,
            device=device,
            seed_base=test_seed_base,
        )
        result = {
            "checkpoint": str(args.hissd_checkpoint.expanduser().resolve()),
            "environment_checkpoint": str(resolved_mappo),
            "difficulty": args.difficulty,
            "skill_mode": args.skill_mode,
            "episodes": args.eval_episodes,
            "test_seed_base": test_seed_base,
            "metrics": metrics,
            "checkpoint_online_finetuning": online_evaluation_metadata,
        }
        print(
            f"TEST success={metrics['success']:.3f} "
            f"goal={metrics['goal_found']:.3f} "
            f"crash={metrics['fatal_crash']:.3f} "
            f"coverage={metrics['coverage']:.3f} "
            f"reward_coverage={metrics['reward_coverage']:.3f} "
            f"return={metrics['episode_return']:.2f}"
        )
        if args.evaluation_output is not None:
            output_path = args.evaluation_output.expanduser().resolve()
            output_path.parent.mkdir(parents=True, exist_ok=True)
            output_path.write_text(
                json.dumps(result, indent=2, default=str), encoding="utf-8"
            )
            print(f"Saved evaluation: {output_path}")
        return
    args.output_dir.mkdir(parents=True, exist_ok=True)
    curve_path = (
        args.learning_curve_output.expanduser().resolve()
        if args.learning_curve_output is not None
        else args.output_dir / f"learning_curve_seed_{args.seed}.json"
    )
    print(
        f"Drone-only PPO difficulty={args.difficulty}, seed={args.seed}, "
        f"checkpoint={args.hissd_checkpoint}, env_checkpoint={resolved_mappo}, "
        f"skill_structure={model.skill_structure}, "
        f"skill_mode={args.skill_mode}, "
        f"credit={args.credit_assignment}, "
        f"pretrained_value={args.use_pretrained_value}"
    )
    print(
        f"frozen offline_skill_decoder={sum(p.numel() for p in task_head.parameters()):,}, "
        f"matched_online_residual={sum(p.numel() for p in no_skill_policy.parameters()):,}, "
        f"base_head={sum(p.numel() for p in base_action_head.parameters()):,}@{args.base_unfreeze_after_joint_steps}, "
        f"encoder_projection={sum(p.numel() for p in encoder_adaptation_layer.parameters()):,}@{args.encoder_unfreeze_after_joint_steps}, "
        f"task_context_adapter={sum(p.numel() for p in context_adapter.parameters()) if context_adapter is not None else 0:,}, "
        f"critic={sum(p.numel() for p in value_head.parameters()):,}"
    )

    baseline = evaluate_policy(
        checkpoint_env_config=checkpoint_env_config,
        model=model,
        no_skill_policy=no_skill_policy,
        value_head=value_head,
        anchor_head=anchor_head,
        anchor_context_adapter=anchor_context_adapter,
        use_pretrained_value=args.use_pretrained_value,
        log_std=log_std,
        args=args,
        device=device,
        seed_base=args.eval_seed_base,
    )
    best_score = evaluation_score(baseline)
    best_success_rate = float(baseline["success"])
    best_state = {
        "model": copy.deepcopy(model.state_dict()),
        "no_skill": copy.deepcopy(no_skill_policy.state_dict()),
        "value": copy.deepcopy(value_head.state_dict()),
        "log_std": log_std.detach().clone(),
        "optimizer": copy.deepcopy(optimizer.state_dict()),
    }
    joint_env_steps = 0
    baseline_point = curve_point(args, baseline, joint_env_steps, 0)
    baseline_point["best_checkpoint_success_rate"] = float(baseline["success"])
    baseline_point["best_checkpoint_validation_score"] = float(best_score)
    baseline_point["validation_regression_streak"] = 0
    append_curve_points(
        curve_path,
        [baseline_point],
        metadata={
            "evaluation_episodes": args.eval_episodes,
            "validation_seed_base": (
                args.seed if args.eval_seed_base is None else args.eval_seed_base
            ),
            "requested_joint_step_budget": args.joint_step_budget,
            "evaluation_joint_step_interval": args.eval_every_joint_steps,
            "source_checkpoint": str(args.hissd_checkpoint.resolve()),
            "environment_checkpoint": str(resolved_mappo),
            "curve_method": args.method_name,
            "skill_structure": model.skill_structure,
            "skill_mode": args.skill_mode,
            "success_definition": (
                "environment_drone_only_mission_success"
            ),
            "success_coverage_definition": (
                "drone_reward_coverage_excluding_base_sectors"
            ),
            "success_min_coverage_ratio": args.success_min_coverage_ratio,
            "training_step_definition": (
                "sum of world cycles from target training episodes; "
                "evaluation cycles excluded"
            ),
            "train_batch_joint_steps": args.train_batch_joint_steps,
            "rollout_envs": args.rollout_envs,
            "multiprocess_rollout": args.multiprocess_rollout,
            "deterministic": args.deterministic,
            "online_adaptation": {
                "matched_bc_initial_policy": bool(
                    args.skill_mode == "no_skill" or args.skill_prior_init == 0.0
                ),
                "action_distribution": "normalized_gaussian_scaled_to_environment",
                "shared_exploration_std": True,
                "skill_conditioned_residual": args.skill_mode == "full",
                "skill_prior_initial_gate": (
                    args.skill_prior_init if args.skill_mode == "full" else 0.0
                ),
                "skill_prior_max_gate": args.skill_prior_max,
                "action_anchor": (
                    "bc_base_policy"
                ),
                "state_dependent_skill_gate": args.skill_mode == "full",
                "skill_gate_lr": args.skill_gate_lr,
                "skill_residual_lr": args.skill_residual_lr,
                "target_kl": args.target_kl,
                "task_context_adapter": context_adapter is not None,
                "context_warmup_iterations": args.context_warmup_iterations,
                "actor_lr": args.actor_lr,
                "base_head_lr": args.base_head_lr,
                "encoder_lr": args.encoder_lr,
                "base_unfreeze_after_joint_steps": (
                    args.base_unfreeze_after_joint_steps
                ),
                "encoder_unfreeze_after_joint_steps": (
                    args.encoder_unfreeze_after_joint_steps
                ),
                "context_lr": args.context_lr,
                "action_anchor_coeff": args.anchor_coeff,
                "skill_anchor_coeff": args.skill_anchor_coeff,
                "shared_terminal_crash_penalty": (
                    args.shared_terminal_crash_penalty
                ),
                "rollback_score_drop": args.rollback_score_drop,
                "rollback_min_best_success": args.rollback_min_best_success,
                "rollback_lr_factor": args.rollback_lr_factor,
                "rollback_patience": args.rollback_patience,
                "pretrained_value": args.use_pretrained_value,
                "credit_assignment": args.credit_assignment,
            },
        },
    )
    print(
        f"BASELINE success={baseline['success']:.3f} "
        f"goal={baseline['goal_found']:.3f} crash={baseline['fatal_crash']:.3f} "
        f"coverage={baseline['coverage']:.3f} "
        f"reward_coverage={baseline['reward_coverage']:.3f} "
        f"return={baseline['episode_return']:.2f}"
    )
    save_checkpoint(
        args.output_dir / "hissd_drone_online_best.pt",
        model,
        no_skill_policy,
        source_payload,
        value_head,
        log_std,
        optimizer,
        iteration=0,
        joint_env_steps=0,
        metrics=baseline,
        args=args,
    )

    config = build_env_config(
        checkpoint_env_config,
        args.difficulty,
        args.success_min_coverage_ratio,
    )
    action_scale = drone_action_scale(config)
    iteration = 0
    validation_regression_streak = 0
    next_eval_step = args.eval_every_joint_steps
    next_last_save_step = args.eval_every_joint_steps
    progress_total = (
        args.joint_step_budget
        if args.joint_step_budget is not None
        else args.iterations
    )
    progress = (
        tqdm(
            total=progress_total,
            initial=joint_env_steps,
            desc=f"{args.skill_mode} D{args.difficulty}",
            unit=("joint-step" if args.joint_step_budget is not None else "iter"),
            dynamic_ncols=True,
            mininterval=0.5,
            file=sys.stdout,
        )
        if tqdm is not None
        else None
    )

    def progress_log(message: str) -> None:
        if progress is not None:
            progress.write(message)
        else:
            print(message)

    train_envs = [
        HeMAC_v0.env(**config)
        for _ in range(args.rollout_envs)
    ]
    train_env = train_envs[0]

    train_worker_pool = None

    if (
        args.multiprocess_rollout
        and args.rollout_envs > 1
    ):
        train_worker_pool = HeMACWorkerPool(
            num_workers=args.rollout_envs,
            config=config,
            action_scale=action_scale,
            reward_scale=args.reward_scale,
            shared_terminal_crash_penalty=(
                args.shared_terminal_crash_penalty
            ),
        )
        progress_log(
            "Started "
            f"{args.rollout_envs} HeMAC CPU rollout workers."
        )


    while (
        joint_env_steps < args.joint_step_budget
        if args.joint_step_budget is not None
        else iteration < args.iterations
    ):
        iteration += 1
        trajectories: list[dict[str, Any]] = []
        episode_metrics = []
        batch_start_steps = joint_env_steps
        episode_index = 0
        while True:
            if args.rollout_envs > 1:
                if args.train_batch_joint_steps > 0:
                    remaining_steps = (
                        args.train_batch_joint_steps
                        - (
                            joint_env_steps
                            - batch_start_steps
                        )
                    )

                    if args.joint_step_budget is not None:
                        remaining_steps = min(
                            remaining_steps,
                            args.joint_step_budget
                            - joint_env_steps,
                        )

                    # Do not launch episodes that the sequential
                    # collector could not possibly need. Since one
                    # episode contributes at most max_cycles cycles,
                    # this keeps PPO batch overshoot comparable to
                    # the original collector.
                    max_episode_cycles = int(
                        config.get(
                            "max_cycles",
                            300,
                        )
                    )

                    minimum_episodes_needed = max(
                        1,
                        (
                            max(
                                int(remaining_steps),
                                1,
                            )
                            + max_episode_cycles
                            - 1
                        )
                        // max_episode_cycles,
                    )

                    wave_count = min(
                        args.rollout_envs,
                        minimum_episodes_needed,
                    )

                else:
                    wave_count = min(
                        args.rollout_envs,
                        args.episodes_per_iteration
                        - episode_index,
                    )

                seeds = [
                    (
                        args.seed
                        + iteration * 10_000
                        + episode_index
                        + offset
                    )
                    for offset in range(
                        wave_count
                    )
                ]

                (
                    batched_episodes,
                    batched_metrics,
                ) = rollout_episodes_batched(
                    envs=train_envs[:wave_count],
                    seeds=seeds,
                    model=model,
                    no_skill_policy=no_skill_policy,
                    value_head=value_head,
                    anchor_head=anchor_head,
                    anchor_context_adapter=(
                        anchor_context_adapter
                    ),
                    use_pretrained_value=(
                        args.use_pretrained_value
                    ),
                    credit_assignment=(
                        args.credit_assignment
                    ),
                    log_std=log_std,
                    action_scale=action_scale,
                    reward_scale=args.reward_scale,
                    shared_terminal_crash_penalty=(
                        args.shared_terminal_crash_penalty
                    ),
                    success_min_coverage_ratio=(
                        args.success_min_coverage_ratio
                    ),
                    device=device,
                    stochastic=True,
                    skill_mode=args.skill_mode,
                    worker_pool=train_worker_pool,
                )

                for (
                    episode,
                    metrics,
                ) in zip(
                    batched_episodes,
                    batched_metrics,
                ):
                    add_per_drone_gae(
                        episode,
                        args.gamma,
                        args.gae_lambda,
                    )

                    trajectories.extend(
                        episode
                    )
                    episode_metrics.append(
                        metrics
                    )

                    episode_joint_steps = int(
                        round(
                            metrics["cycles"]
                        )
                    )

                    previous_joint_steps = (
                        joint_env_steps
                    )

                    joint_env_steps += (
                        episode_joint_steps
                    )

                    if (
                        progress is not None
                        and args.joint_step_budget
                        is not None
                    ):
                        progress.update(
                            min(
                                joint_env_steps,
                                args.joint_step_budget,
                            )
                            - min(
                                previous_joint_steps,
                                args.joint_step_budget,
                            )
                        )

                    episode_index += 1

                if (
                    args.joint_step_budget
                    is not None
                    and joint_env_steps
                    >= args.joint_step_budget
                ):
                    break

                if (
                    args.train_batch_joint_steps
                    > 0
                ):
                    if (
                        joint_env_steps
                        - batch_start_steps
                        >= args.train_batch_joint_steps
                    ):
                        break

                elif (
                    episode_index
                    >= args.episodes_per_iteration
                ):
                    break

                continue

            episode, metrics = rollout_episode(
                    env=train_env,
                    model=model,
                    no_skill_policy=no_skill_policy,
                    value_head=value_head,
                    anchor_head=anchor_head,
                    anchor_context_adapter=anchor_context_adapter,
                    use_pretrained_value=args.use_pretrained_value,
                    credit_assignment=args.credit_assignment,
                    log_std=log_std,
                    action_scale=action_scale,
                    reward_scale=args.reward_scale,
                    shared_terminal_crash_penalty=args.shared_terminal_crash_penalty,
                    success_min_coverage_ratio=args.success_min_coverage_ratio,
                    seed=args.seed + iteration * 10_000 + episode_index,
                    device=device,
                    stochastic=True,
                    skill_mode=args.skill_mode,
                )
            if args.credit_assignment == "agent":
                add_per_drone_gae(episode, args.gamma, args.gae_lambda)
            else:
                add_gae(episode, args.gamma, args.gae_lambda)
            trajectories.extend(episode)
            episode_metrics.append(metrics)
            episode_joint_steps = int(round(metrics["cycles"]))
            previous_joint_steps = joint_env_steps
            joint_env_steps += episode_joint_steps
            if progress is not None and args.joint_step_budget is not None:
                progress.update(
                    min(joint_env_steps, args.joint_step_budget)
                    - min(previous_joint_steps, args.joint_step_budget)
                )
            episode_index += 1
            if (
                args.joint_step_budget is not None
                and joint_env_steps >= args.joint_step_budget
            ):
                break
            if args.train_batch_joint_steps > 0:
                if joint_env_steps - batch_start_steps >= args.train_batch_joint_steps:
                    break
            elif episode_index >= args.episodes_per_iteration:
                break
        adapt_context = (
            args.skill_mode == "full"
            and
            context_adapter is not None
            and iteration > args.context_warmup_iterations
        )
        adapt_base_head = (
            joint_env_steps >= args.base_unfreeze_after_joint_steps
        )
        adapt_encoder = (
            joint_env_steps >= args.encoder_unfreeze_after_joint_steps
        )
        for parameter in base_action_head.parameters():
            parameter.requires_grad_(adapt_base_head)
        for parameter in encoder_adaptation_layer.parameters():
            parameter.requires_grad_(adapt_encoder)
        if context_adapter is not None:
            for parameter in context_adapter.parameters():
                parameter.requires_grad_(adapt_context)
        update = ppo_update(
            model,
            no_skill_policy,
            value_head,
            log_std,
            optimizer,
            trajectories,
            args,
            device,
            action_scale=action_scale,
            adapt_context=adapt_context,
            adapt_base_head=adapt_base_head,
            adapt_encoder=adapt_encoder,
            skill_mode=args.skill_mode,
        )
        train = average_metrics(episode_metrics)
        if progress is not None and args.joint_step_budget is None:
            progress.update(1)
        progress_target = (
            f"steps_target={args.joint_step_budget}"
            if args.joint_step_budget is not None
            else f"iterations_target={args.iterations}"
        )
        progress_log(
            f"iter={iteration:03d} steps={joint_env_steps} {progress_target} "
            f"success={train['success']:.3f} crash={train['fatal_crash']:.3f} "
            f"episodes={len(episode_metrics)} return={train['episode_return']:.2f} "
            f"policy={update['policy_loss']:.4f} value={update['value_loss']:.4f} "
            f"kl={update['approx_kl']:.5f}/{update['max_approx_kl']:.5f} "
            f"clip={update['clip_fraction']:.3f} "
            f"skill_delta={update['skill_action_delta']:.4f} "
            f"skill_gate={update['skill_prior_gate']:.4f} "
            f"skill_keep={update['skill_prior_retention']:.3f} "
            f"kl_stop={int(update['early_stop_kl'])} "
            f"std={float(log_std.mean().detach()):.3f} "
            f"base={'on' if adapt_base_head else 'frozen'} "
            f"encoder={'on' if adapt_encoder else 'frozen'} "
            f"context={'on' if adapt_context else 'warmup'}"
        )
        if progress is not None:
            progress.set_postfix(
                train_success=f"{train['success']:.3f}",
                crash=f"{train['fatal_crash']:.3f}",
                kl=f"{update['approx_kl']:.4f}",
                best=f"{best_success_rate:.3f}",
                refresh=False,
            )
        should_save_last = (
            args.joint_step_budget is None
            or joint_env_steps >= next_last_save_step
            or (
                args.joint_step_budget is not None
                and joint_env_steps >= args.joint_step_budget
            )
        )
        if should_save_last:
            save_checkpoint(
                args.output_dir / "hissd_drone_online_last.pt",
                model,
                no_skill_policy,
                source_payload,
                value_head,
                log_std,
                optimizer,
                iteration=iteration,
                joint_env_steps=joint_env_steps,
                metrics={**train, **update},
                args=args,
            )
            if args.joint_step_budget is not None:
                while next_last_save_step <= joint_env_steps:
                    next_last_save_step += args.eval_every_joint_steps
        if args.joint_step_budget is not None:
            should_evaluate = joint_env_steps >= next_eval_step
            scheduled_eval_step = min(next_eval_step, args.joint_step_budget)
        else:
            should_evaluate = iteration % args.eval_every == 0
            scheduled_eval_step = None
        if not should_evaluate:
            continue
        evaluation = evaluate_policy(
            checkpoint_env_config=checkpoint_env_config,
            model=model,
            no_skill_policy=no_skill_policy,
            value_head=value_head,
            anchor_head=anchor_head,
            anchor_context_adapter=anchor_context_adapter,
            use_pretrained_value=args.use_pretrained_value,
            log_std=log_std,
            args=args,
            device=device,
            seed_base=args.eval_seed_base,
            worker_pool=train_worker_pool,
        )
        score = evaluation_score(evaluation)
        rollback_eligible = best_success_rate >= args.rollback_min_best_success
        regressed = rollback_eligible and validation_regressed(
            score, best_score, args.rollback_score_drop
        )
        validation_regression_streak = (
            validation_regression_streak + 1 if regressed else 0
        )
        rollback_triggered = (
            regressed
            and validation_regression_streak >= args.rollback_patience
        )
        point = curve_point(
            args,
            evaluation,
            joint_env_steps,
            iteration,
            scheduled_joint_env_steps=scheduled_eval_step,
            update_metrics=update,
            train_metrics=train,
        )
        point["validation_score"] = score
        point["best_validation_score_before_update"] = best_score
        point["rollback_eligible"] = float(rollback_eligible)
        point["validation_regressed"] = float(regressed)
        point["validation_regression_streak"] = validation_regression_streak
        point["rollback_triggered"] = float(rollback_triggered)
        if score > best_score:
            point["best_checkpoint_success_rate"] = float(evaluation["success"])
            point["best_checkpoint_validation_score"] = float(score)
        else:
            point["best_checkpoint_success_rate"] = float(best_success_rate)
            point["best_checkpoint_validation_score"] = float(best_score)
        append_curve_points(
            curve_path,
            [point],
        )
        if args.joint_step_budget is not None:
            while next_eval_step <= joint_env_steps:
                next_eval_step += args.eval_every_joint_steps
        progress_log(
            f"EVAL success={evaluation['success']:.3f} "
            f"goal={evaluation['goal_found']:.3f} "
            f"crash={evaluation['fatal_crash']:.3f} "
            f"coverage={evaluation['coverage']:.3f} "
            f"reward_coverage={evaluation['reward_coverage']:.3f} "
            f"return={evaluation['episode_return']:.2f} score={score:.4f}"
        )
        if score > best_score:
            best_score = score
            best_success_rate = float(evaluation["success"])
            validation_regression_streak = 0
            if progress is not None:
                progress.set_postfix(
                    train_success=f"{train['success']:.3f}",
                    val_success=f"{evaluation['success']:.3f}",
                    kl=f"{update['approx_kl']:.4f}",
                    best=f"{best_success_rate:.3f}",
                    refresh=True,
                )
            best_state = {
                "model": copy.deepcopy(model.state_dict()),
                "no_skill": copy.deepcopy(no_skill_policy.state_dict()),
                "value": copy.deepcopy(value_head.state_dict()),
                "log_std": log_std.detach().clone(),
                "optimizer": copy.deepcopy(optimizer.state_dict()),
            }
            save_checkpoint(
                args.output_dir / "hissd_drone_online_best.pt",
                model,
                no_skill_policy,
                source_payload,
                value_head,
                log_std,
                optimizer,
                iteration=iteration,
                joint_env_steps=joint_env_steps,
                metrics=evaluation,
                args=args,
            )
        elif rollback_triggered:
            current_lrs = [group["lr"] for group in optimizer.param_groups]
            model.load_state_dict(best_state["model"])
            no_skill_policy.load_state_dict(best_state["no_skill"])
            value_head.load_state_dict(best_state["value"])
            with torch.no_grad():
                log_std.copy_(best_state["log_std"])
            optimizer.load_state_dict(best_state["optimizer"])
            for group, current_lr in zip(optimizer.param_groups, current_lrs):
                group["lr"] = current_lr * args.rollback_lr_factor
            best_state["optimizer"] = copy.deepcopy(optimizer.state_dict())
            validation_regression_streak = 0
            progress_log(
                "ROLLBACK restored best validation policy; "
                f"score_drop={best_score - score:.4f}, "
                f"actor_lr={optimizer.param_groups[0]['lr']:.2e}"
            )

    if train_worker_pool is not None:
        train_worker_pool.close()

    for train_env_instance in train_envs:
        train_env_instance.close()

    if progress is not None:
        progress.close()
    model.load_state_dict(best_state["model"])
    no_skill_policy.load_state_dict(best_state["no_skill"])
    value_head.load_state_dict(best_state["value"])
    with torch.no_grad():
        log_std.copy_(best_state["log_std"])
    optimizer.load_state_dict(best_state["optimizer"])
    save_checkpoint(
        args.output_dir / "hissd_drone_online_final.pt",
        model,
        no_skill_policy,
        source_payload,
        value_head,
        log_std,
        optimizer,
        iteration=iteration,
        joint_env_steps=joint_env_steps,
        metrics={"best_score": best_score},
        args=args,
    )
    print(f"Saved learning curve: {curve_path}")


if __name__ == "__main__":
    main()
